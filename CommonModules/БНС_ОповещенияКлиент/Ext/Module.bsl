#Область ПрограммныйИнтерфейс

// Показывает пользователю информационное оповещение.
//
// Параметры:
//  Текст - Строка - Текст оповещения.
//  Пояснение - Строка - Дополнительное пояснение.
//
Процедура ОповеститьПользователя(Текст, Пояснение = "") Экспорт

	ПоказатьОповещениеПользователя(Текст, , Пояснение,
		БиблиотекаКартинок.Информация, СтатусОповещенияПользователя.Информация);

КонецПроцедуры

