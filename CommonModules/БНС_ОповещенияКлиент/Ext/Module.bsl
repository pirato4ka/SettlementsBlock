
#Область ПрограммныйИнтерфейс

Процедура ОповеститьПользователя(Текст, Пояснение = "") Экспорт

	ПоказатьОповещениеПользователя(Текст, , Пояснение,
		БиблиотекаКартинок.Информация, СтатусОповещенияПользователя.Информация);

КонецПроцедуры

Процедура ОповеститьОбОшибке(Текст, Пояснение = "") Экспорт

	ПоказатьОповещениеПользователя(Текст, , Пояснение,
		БиблиотекаКартинок.Внимание, СтатусОповещенияПользователя.Ошибка);

КонецПроцедуры

Процедура ОповеститьОПредупреждении(Текст, Пояснение = "") Экспорт

	ПоказатьОповещениеПользователя(Текст, , Пояснение,
		БиблиотекаКартинок.Внимание, СтатусОповещенияПользователя.Предупреждение);

КонецПроцедуры

Процедура РазрешитьОтгрузку(ДокументСсылка, Комментарий = "") Экспорт

	Попытка
		БНС_Подписки.УстановитьСтатусКонтроля(ДокументСсылка,
			Перечисления.БНС_СтатусыФинансовогоКонтроля.ОтгрузкаРазрешена, Комментарий);
		ОповеститьПользователя("Отгрузка разрешена",
			"Документ проведён без проверки лимита дебиторской задолженности");
	Исключение
		ОповеститьОбОшибке("Не удалось разрешить отгрузку",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗапретитьОтгрузку(ДокументСсылка, Комментарий = "") Экспорт

	Попытка
		БНС_Подписки.УстановитьСтатусКонтроля(ДокументСсылка,
			Перечисления.БНС_СтатусыФинансовогоКонтроля.ОтгрузкаЗапрещена, Комментарий);
		ОповеститьОПредупреждении("Отгрузка запрещена",
			"Документ нельзя провести до снятия запрета контролером");
	Исключение
		ОповеститьОбОшибке("Не удалось запретить отгрузку",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
