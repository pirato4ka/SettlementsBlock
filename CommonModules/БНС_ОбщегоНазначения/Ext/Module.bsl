
#Область ПрограммныйИнтерфейс

Функция ИспользоватьФинансовыйКонтроль() Экспорт

	Возврат Константы.БНС_ИспользоватьФинансовыйКонтроль.Получить();

КонецФункции

Процедура ВывестиСообщение(Текст, Источник = Неопределено) Экспорт

	Попытка
		ОбщегоНазначения.СообщитьПользователю(Текст, "", КлючДанныхСообщения(Источник));
	Исключение
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецПопытки;

КонецПроцедуры

Функция КлючДанныхСообщения(Источник)

	Если Источник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Возврат Источник;
	КонецЕсли;

	Попытка
		Если Источник.Ссылка.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Источник.Ссылка;
	Исключение
		Возврат Источник;
	КонецПопытки;

КонецФункции

Процедура ЗафиксироватьОтказ(ДокументОбъект, Текст) Экспорт

	ЗаписатьВЖурнал(ДокументОбъект, "БНС.ФинансовыйКонтроль.Отказ",
		УровеньЖурналаРегистрации.Предупреждение, Текст);

КонецПроцедуры

Процедура ЗафиксироватьСбой(ДокументОбъект, ОписаниеОшибки) Экспорт

	ЗаписатьВЖурнал(ДокументОбъект, "БНС.ФинансовыйКонтроль.Сбой",
		УровеньЖурналаРегистрации.Ошибка, "Сбой контроля лимитов: " + ОписаниеОшибки);

КонецПроцедуры

Процедура ЗаписатьИсторию(ДокументОбъект, Статус, Лимит, Задолженность,
	СуммаДокумента, Превышение) Экспорт

	Запись = РегистрыСведений.БНС_ИсторияФинансовогоКонтроля.СоздатьМенеджерЗаписи();

	Запись.Период   = НачалоДня(ДокументОбъект.Дата);
	Запись.Документ = ДокументОбъект.Ссылка;
	Запись.Статус   = Статус;
	Запись.СуммаДокумента = СуммаДокумента;
	Запись.Превышение     = Превышение;
	Запись.Пользователь   = Пользователи.АвторизованныйПользователь();

	Если Лимит <> Неопределено Тогда
		Запись.ПрименимыйЛимит       = Лимит.Лимит;
		Запись.ДействиеПриНарушении  = Лимит.ДействиеПриНарушении;
		Запись.ЛимитСуммы            = Лимит.ЛимитСуммы;
	КонецЕсли;

	Если Задолженность <> Неопределено Тогда
		Запись.Долг              = Задолженность.Долг;
		Запись.МаксПросрочкаДней = Задолженность.МаксПросрочкаДней;
		Запись.СуммаПросрочки    = Задолженность.СуммаПросрочки;

		Если ЗначениеЗаполнено(Задолженность.ДокументПросрочки) Тогда
			Запись.ДокументПросрочки = Задолженность.ДокументПросрочки;
		КонецЕсли;
	КонецЕсли;

	Запись.Записать(Истина);

КонецПроцедуры

Функция ЕстьПравоизменятьСтатус() Экспорт

	Возврат ПравоДоступа("Добавление", Метаданные.РегистрыСведений.БНС_ИсторияФинансовогоКонтроля);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьВЖурнал(ДокументОбъект, ИмяСобытия, Уровень, Текст)

	Попытка
		Данные = Новый Структура;
		Данные.Вставить("Документ", Строка(ДокументОбъект.Ссылка));
		Данные.Вставить("Дата",     Формат(ДокументОбъект.Дата, "ДЛФ=DT"));
		Данные.Вставить("Партнер",  Строка(ДокументОбъект.Партнер));
		Данные.Вставить("Пользователь", Строка(Пользователи.АвторизованныйПользователь()));

		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, , , Данные, Текст);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
