#Область ПрограммныйИнтерфейс

// Возвращает признак включения подсистемы финансового контроля.
//
// Возвращаемое значение:
//  Булево - Истина, если контроль включен.
//
Функция ИспользоватьФинансовыйКонтроль() Экспорт

	Возврат ПолучитьФункциональнуюОпцию("БНС_ФинансовыйКонтроль");

КонецФункции

// Выводит сообщение пользователю, привязывая его к документу.
//
// Параметры:
//  Текст - Строка - Текст сообщения.
//  Источник - ДокументОбъект, ДокументСсылка, Неопределено - Объект, к которому привязывается сообщение.
//
Процедура ВывестиСообщение(Текст, Источник = Неопределено) Экспорт

	Попытка
		ОбщегоНазначения.СообщитьПользователю(Текст, , КлючДанныхСообщения(Источник));
	Исключение
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецПопытки;

КонецПроцедуры

// Записывает в журнал регистрации отказ в проведении.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Текст - Строка - Причина отказа.
//
Процедура ЗафиксироватьОтказ(ДокументОбъект, Текст) Экспорт

	ЗаписатьВЖурнал(ДокументОбъект, "БНС.ФинансовыйКонтроль.Отказ",
		УровеньЖурналаРегистрации.Предупреждение, Текст);

КонецПроцедуры

// Записывает в журнал регистрации сбой контроля.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  ОписаниеОшибки - Строка - Описание ошибки.
//
Процедура ЗафиксироватьСбой(ДокументОбъект, ОписаниеОшибки) Экспорт

	ЗаписатьВЖурнал(ДокументОбъект, "БНС.ФинансовыйКонтроль.Сбой",
		УровеньЖурналаРегистрации.Ошибка, "Сбой контроля лимитов: " + ОписаниеОшибки);

КонецПроцедуры

// Записывает снимок проверки в историю финансового контроля.
// Запись выполняется привилегированным модулем, поэтому роль просмотра
// не требует права изменения регистра истории.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Статус - ПеречислениеСсылка.БНС_СтатусыФинансовогоКонтроля - Статус после проверки.
//  Результат - Структура, Неопределено - Результат расчета контроля.
//
Процедура ЗаписатьИсторию(ДокументОбъект, Статус, Результат = Неопределено) Экспорт

	БНС_ИсторияФинансовогоКонтроляСервер.ЗаписатьИсторию(ДокументОбъект, Статус, Результат);

КонецПроцедуры

// Проверяет право пользователя принимать решение по отгрузке.
// Право определяется выделенной ролью, а не правом записи регистра истории.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь может менять статус финансового контроля.
//
Функция ПравоНаИзменениеСтатуса() Экспорт

	Возврат РольДоступна("БНС_ФинансовыйКонтроль_Изменение");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает ключ данных сообщения для привязки сообщения к объекту.
//
// Параметры:
//  Источник - ДокументОбъект, ДокументСсылка, Неопределено - Объект сообщения.
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - Ключ данных сообщения.
//
Функция КлючДанныхСообщения(Источник)

	Если Источник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Возврат Источник;
	КонецЕсли;

	Попытка
		Если Источник.Ссылка.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Источник.Ссылка;
	Исключение
		Возврат Источник;
	КонецПопытки;

КонецФункции

// Записывает событие в журнал регистрации, не прерывая основной алгоритм.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  ИмяСобытия - Строка - Имя события журнала.
//  Уровень - УровеньЖурналаРегистрации - Уровень события.
//  Текст - Строка - Текст события.
//
Процедура ЗаписатьВЖурнал(ДокументОбъект, ИмяСобытия, Уровень, Текст)

	Попытка

		Ссылка = ДокументОбъект.Ссылка;

		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ДокументОбъект.Метаданные(),
			?(ЗначениеЗаполнено(Ссылка), Ссылка, Неопределено), ТекстСобытия(ДокументОбъект, Текст));

	Исключение
		// Журналирование не должно мешать контролю.
	КонецПопытки;

КонецПроцедуры

// Дополняет текст события журнала контекстом документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Текст - Строка - Причина или описание события.
//
// Возвращаемое значение:
//  Строка - Текст записи журнала регистрации.
//
Функция ТекстСобытия(ДокументОбъект, Текст)

	Части = Новый Массив;
	Части.Добавить(Текст);

	Попытка
		Части.Добавить("Документ: " + Строка(ДокументОбъект.Ссылка)
			+ ", дата: " + Формат(ДокументОбъект.Дата, "ДЛФ=DT"));
	Исключение
		// Контекст документа необязателен.
	КонецПопытки;

	Попытка
		Если ДокументОбъект.Метаданные().Реквизиты.Найти("Партнер") <> Неопределено
			И ЗначениеЗаполнено(ДокументОбъект.Партнер) Тогда
			Части.Добавить("Партнер: " + Строка(ДокументОбъект.Партнер));
		КонецЕсли;
	Исключение
		// Реквизит партнера необязателен.
	КонецПопытки;

	Попытка
		Части.Добавить("Пользователь: " + Строка(Пользователи.АвторизованныйПользователь()));
	Исключение
		// Пользователь может быть не определен при фоновых заданиях.
	КонецПопытки;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти
