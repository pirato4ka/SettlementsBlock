
&После("ПриИзмененииПолучателяОтправителя")
Процедура БНС_ПриИзмененииПолучателяОтправителя(ЭлементыФормы, ДокОбъект, ПараметрыЗаполнения)
	
	// Типовой код заполняет поле «Адрес доставки» первым попавшимся значением из статистики. 
	// Выполнена доработка: адрес теперь берётся из карточки партнёра независимо от статистики.
	// Реализация выполнена в обработчике «После», так как реализация через «ИзменениеИКонтроль» сопряжена с повышенным риском отвала расширения.
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПараметрыЗаполненияРеквизитов();
	КонецЕсли;
	
	Если ПараметрыЗаполнения.УстановитьАдресДоставки Тогда
		
		РеквизитыДоставки     = РеквизитыДоставки(ДокОбъект);
		ПолучательОтправитель = РеквизитыДоставки.ПолучательОтправитель;
		
		АдресаПолучателяИзКонтактнойИнформации = АдресаПолучателяИзКонтактнойИнформации(ПолучательОтправитель.Значение);
		
		Если АдресаПолучателяИзКонтактнойИнформации.Количество() Тогда
			
			ПерваяСтруктураВСписке = АдресаПолучателяИзКонтактнойИнформации[0];
			РеквизитыДоставки.АдресДоставки              = ПерваяСтруктураВСписке.АдресДоставки;
			РеквизитыДоставки.АдресДоставкиЗначение      = ПерваяСтруктураВСписке.АдресДоставкиЗначение;
			РеквизитыДоставки.АдресДоставкиЗначенияПолей = ПерваяСтруктураВСписке.АдресДоставкиЗначенияПолей;

			ЗаполнитьЗначенияСвойств(ДокОбъект, РеквизитыДоставки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
