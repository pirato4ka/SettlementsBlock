
#Область ПрограммныйИнтерфейс

Процедура ПроверитьПередОтгрузкой(ДокументОбъект, Отказ) Экспорт

	Попытка
		ВыполнитьПроверку(ДокументОбъект, Отказ);
	Исключение
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(ДокументОбъект, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ВыполнитьПроверку(ДокументОбъект, Отказ)

	Если Не БНС_ОбщегоНазначения.ИспользоватьФинансовыйКонтроль() Тогда
		Возврат;
	КонецЕсли;

	Если ДокументОбъект.ОбменДанными.Загрузка
		ИЛИ ДокументОбъект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;

	Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена Тогда
		Возврат;
	КонецЕсли;

	Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена Тогда
		Отказ = Истина;
		Текст = "Отгрузка запрещена контролером";
		Если ЗначениеЗаполнено(ДокументОбъект.БНС_РазрешилОтгрузку) Тогда
			Текст = Текст + " " + Строка(ДокументОбъект.БНС_РазрешилОтгрузку);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДокументОбъект.БНС_ДатаРазрешения) Тогда
			Текст = Текст + " от " + Формат(ДокументОбъект.БНС_ДатаРазрешения, "ДЛФ=DT");
		КонецЕсли;
		Текст = Текст + ".";
		Если ЗначениеЗаполнено(ДокументОбъект.БНС_КомментарийКонтролера) Тогда
			Текст = Текст + " Комментарий: " + ДокументОбъект.БНС_КомментарийКонтролера;
		КонецЕсли;
		Текст = Текст + Символы.ПС + "Документ можно сохранить без проведения - кнопка ""Записать"".";
		БНС_ОбщегоНазначения.ВывестиСообщение(Текст, ДокументОбъект);
		БНС_ОбщегоНазначения.ЗафиксироватьОтказ(ДокументОбъект, Текст);
		Возврат;
	КонецЕсли;

	Партнер        = ДокументОбъект.Партнер;
	МоментПроверки = КонецДня(ДокументОбъект.Дата);

	Лимит = ЛимитНаДату(Партнер, МоментПроверки);

	Если Лимит = Неопределено Тогда
		ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.Пусто;
		ОчиститьСнимок(ДокументОбъект);
		БНС_ОбщегоНазначения.ЗаписатьИсторию(ДокументОбъект, Статусы.Пусто, Неопределено,
			Неопределено, 0, 0);
		Возврат;
	КонецЕсли;

	СписокПартнеров = ПартнерыОбъектаКонтроля(Лимит.ОбъектКонтроля, Партнер);

	Задолженность = ЗадолженностьНаДату(СписокПартнеров, МоментПроверки, ДокументОбъект.Ссылка);

	СуммаДокумента = СуммаДокументаДляКонтроля(ДокументОбъект);
	ПрогнозныйДолг = Задолженность.Долг + СуммаДокумента;

	ПревышениеСуммы = Макс(0, ПрогнозныйДолг - Лимит.ЛимитСуммы);
	ПревышениеСрока = Задолженность.МаксПросрочкаДней - Лимит.ДопустимаяПросрочкаДней;

	ЗаполнитьСнимок(ДокументОбъект, Лимит, Задолженность, ПревышениеСуммы);

	Если ПревышениеСуммы <= 0 И ПревышениеСрока <= 0 Тогда
		ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.Пусто;
		БНС_ОбщегоНазначения.ЗаписатьИсторию(ДокументОбъект, Статусы.Пусто, Лимит, Задолженность,
			СуммаДокумента, 0);
		Возврат;
	КонецЕсли;

	Текст = ТекстНарушения(ДокументОбъект, Лимит, Задолженность, СуммаДокумента,
		ПрогнозныйДолг, ПревышениеСуммы, ПревышениеСрока);

	Если Лимит.ДействиеПриНарушении = Перечисления.БНС_ДействияПриНарушении.Запретить Тогда
		Отказ = Истина;
		БНС_ОбщегоНазначения.ЗафиксироватьОтказ(ДокументОбъект, Текст);
	КонецЕсли;

	ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.НаПроверке;

	БНС_ОбщегоНазначения.ВывестиСообщение(Текст, ДокументОбъект);

	БНС_ОбщегоНазначения.ЗаписатьИсторию(ДокументОбъект, Статусы.НаПроверке, Лимит, Задолженность,
		СуммаДокумента, ПревышениеСуммы);

КонецПроцедуры

Функция ЛимитНаДату(Партнер, МоментПроверки) Экспорт

	Группа     = Партнер.БНС_ГруппаКлиентов;
	Контрагент = КонтрагентПартнера(Партнер);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Лимит КАК Лимит,
	|	Значения.Лимит.БНС_ОбъектКонтроля КАК ОбъектКонтроля,
	|	Значения.Период КАК Период,
	|	Значения.ЛимитСуммы КАК ЛимитСуммы,
	|	Значения.Валюта КАК Валюта,
	|	Значения.ДопустимаяПросрочкаДней КАК ДопустимаяПросрочкаДней,
	|	Значения.ДействиеПриНарушении КАК ДействиеПриНарушении,
	|	Значения.ДействуетПо КАК ДействуетПо
	|ИЗ
	|	РегистрСведений.БНС_ЗначенияЛимитов КАК Значения
	|ГДЕ
	|	Значения.Период <= &МоментПроверки
	|	И НЕ Значения.Лимит.ПометкаУдаления
	|	И Значения.Лимит.БНС_Активна
	|	И (Значения.Лимит.БНС_ОбъектКонтроля = &Партнер
	|		ИЛИ Значения.Лимит.БНС_ОбъектКонтроля = &Контрагент
	|		ИЛИ Значения.Лимит.БНС_ОбъектКонтроля = &Группа)
	|УПОРЯДОЧИТЬ ПО
	|	Значения.Период УБЫВ";

	Запрос.УстановитьПараметр("МоментПроверки", МоментПроверки);
	Запрос.УстановитьПараметр("Партнер",    Партнер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Группа",     Группа);

	Выборка = Запрос.Выполнить().Выбрать();

	Лучший     = Неопределено;
	ЛучшийБалл = 99;

	Пока Выборка.Следующий() Цикл

		Если ЗначениеЗаполнено(Выборка.ДействуетПо)
			И Выборка.ДействуетПо < МоментПроверки Тогда
			Продолжить;
		КонецЕсли;

		Балл = ПриоритетОбъектаКонтроля(Выборка.ОбъектКонтроля, Партнер, Контрагент, Группа);

		Если Балл < ЛучшийБалл Тогда
			ЛучшийБалл = Балл;
			Лучший = Новый Структура("Лимит, ОбъектКонтроля, Период, ДействуетПо,
				|ЛимитСуммы, Валюта, ДопустимаяПросрочкаДней, ДействиеПриНарушении");
			ЗаполнитьЗначенияСвойств(Лучший, Выборка);
		КонецЕсли;

	КонецЦикла;

	Если Лучший <> Неопределено Тогда
		Лучший.ЛимитСуммы = ПересчитатьВВалютуОтчета(Лучший.ЛимитСуммы, Лучший.Валюта, МоментПроверки);
	КонецЕсли;

	Возврат Лучший;

КонецФункции

Функция ПриоритетОбъектаКонтроля(ОбъектКонтроля, Партнер, Контрагент, Группа)

	Если ОбъектКонтроля = Партнер И ЗначениеЗаполнено(Партнер) Тогда
		Возврат 1;
	ИначеЕсли ОбъектКонтроля = Контрагент И ЗначениеЗаполнено(Контрагент) Тогда
		Возврат 2;
	ИначеЕсли ОбъектКонтроля = Группа И ЗначениеЗаполнено(Группа) Тогда
		Возврат 3;
	КонецЕсли;

	Возврат 9;

КонецФункции
Функция ПартнерыОбъектаКонтроля(ОбъектКонтроля, Партнер) Экспорт

	Результат = Новый Массив;

	Если ТипЗнч(ОбъектКонтроля) = Тип("СправочникСсылка.БНС_ГруппыКлиентов")
		И ЗначениеЗаполнено(ОбъектКонтроля) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Партнеры.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|ГДЕ
		|	Партнеры.БНС_ГруппаКлиентов = &Группа
		|	И НЕ Партнеры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Группа", ОбъектКонтроля);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Партнер);
		КонецЦикла;

	КонецЕсли;

	Если Результат.Количество() = 0 И ЗначениеЗаполнено(Партнер) Тогда
		Результат.Добавить(Партнер);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЗадолженностьНаДату(Партнеры, МоментПроверки, ИсключитьДокумент = Неопределено) Экспорт

	Результат = Новый Структура(
		"Долг, МаксПросрочкаДней, ДокументПросрочки, СуммаПросрочки, Расшифровка",
		0, 0, Неопределено, 0, Новый ТаблицаЗначений);

	Если Партнеры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.Регистратор КАК Регистратор,
	|	СУММА(Расчеты.СуммаРасчетовОстаток) КАК ОстатокДолга
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(&Момент,
	|		Партнер В (&Партнеры)) КАК Расчеты
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.Регистратор
	|ИМЕЮЩИЕ
	|	СУММА(Расчеты.СуммаРасчетовОстаток) > 0";

	Запрос.УстановитьПараметр("Момент", МоментПроверки);
	Запрос.УстановитьПараметр("Партнеры", Партнеры);

	Расшифровка = Новый ТаблицаЗначений;
	Расшифровка.Колонки.Добавить("Документ",      Новый ОписаниеТипов("ДокументСсылка"));
	Расшифровка.Колонки.Добавить("ДатаОтгрузки",  Новый ОписаниеТипов("Дата"));
	Расшифровка.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Расшифровка.Колонки.Добавить("СрокОплаты",    Новый ОписаниеТипов("Дата"));
	Расшифровка.Колонки.Добавить("ДнейПросрочки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0)));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если ИсключитьДокумент <> Неопределено
			И Выборка.Регистратор = ИсключитьДокумент Тогда
			Продолжить;
		КонецЕсли;

		ДатаОтгрузки  = Выборка.Регистратор.Дата;
		СрокОплаты    = КонецДня(ДатаОтгрузки + ОтсрочкаПоДоговору(Выборка.Регистратор) * 86400);
		ДнейПросрочки = Макс(0, (НачалоДня(МоментПроверки) - НачалоДня(СрокОплаты)) / 86400);

		СтрокаРасшифровки = Расшифровка.Добавить();
		СтрокаРасшифровки.Документ      = Выборка.Регистратор;
		СтрокаРасшифровки.ДатаОтгрузки  = ДатаОтгрузки;
		СтрокаРасшифровки.Сумма         = Выборка.ОстатокДолга;
		СтрокаРасшифровки.СрокОплаты    = СрокОплаты;
		СтрокаРасшифровки.ДнейПросрочки = ДнейПросрочки;

		Результат.Долг = Результат.Долг + Выборка.ОстатокДолга;

		Если ДнейПросрочки > Результат.МаксПросрочкаДней Тогда
			Результат.МаксПросрочкаДней = ДнейПросрочки;
			Результат.ДокументПросрочки = Выборка.Регистратор;
			Результат.СуммаПросрочки    = Выборка.ОстатокДолга;
		КонецЕсли;

	КонецЦикла;

	Расшифровка.Сортировать("ДнейПросрочки УБЫВ");
	Результат.Расшифровка = Расшифровка;

	Возврат Результат;

КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстНарушения(ДокументОбъект, Лимит, Задолженность, СуммаДокумента,
	ПрогнозныйДолг, ПревышениеСуммы, ПревышениеСрока) Экспорт

	Текст = Новый Массив;
	Текст.Добавить("Финансовый контроль: превышен лимит дебиторской задолженности.");
	Текст.Добавить("Правило: " + Строка(Лимит.Лимит)
		+ " (версия с " + Формат(Лимит.Период, "ДЛФ=D") + ")");
	Текст.Добавить("Долг на дату документа: " + Формат(Задолженность.Долг, "ЧДЦ=2; ЧН=")
		+ ", сумма документа: " + Формат(СуммаДокумента, "ЧДЦ=2; ЧН="));
	Текст.Добавить("Прогнозный долг: " + Формат(ПрогнозныйДолг, "ЧДЦ=2; ЧН=")
		+ ", лимит: " + Формат(Лимит.ЛимитСуммы, "ЧДЦ=2; ЧН="));

	Если ПревышениеСуммы > 0 Тогда
		Текст.Добавить("Превышение лимита: " + Формат(ПревышениеСуммы, "ЧДЦ=2; ЧН="));
	КонецЕсли;

	Если ПревышениеСрока > 0 Тогда
		Текст.Добавить("Просрочка сверх допустимой ("
			+ Формат(Лимит.ДопустимаяПросрочкаДней, "ЧГ=0") + " дн.):");

		Для Каждого СтрокаРасшифровки Из Задолженность.Расшифровка Цикл
			Если СтрокаРасшифровки.ДнейПросрочки <= Лимит.ДопустимаяПросрочкаДней Тогда
				Продолжить;
			КонецЕсли;
			Текст.Добавить("  - " + Строка(СтрокаРасшифровки.Документ)
				+ " от " + Формат(СтрокаРасшифровки.ДатаОтгрузки, "ДЛФ=D")
				+ ", " + Формат(СтрокаРасшифровки.Сумма, "ЧДЦ=2; ЧН=")
				+ ", просрочка " + Формат(СтрокаРасшифровки.ДнейПросрочки, "ЧГ=0") + " дн.");
		КонецЦикла;
	КонецЕсли;

	Если Лимит.ДействиеПриНарушении = Перечисления.БНС_ДействияПриНарушении.Запретить Тогда
		Текст.Добавить("Действие: проведение запрещено, требуется разрешение контролера.");
	Иначе
		Текст.Добавить("Действие: предупреждение. Документ проводится со статусом ""На проверке"".");
	КонецЕсли;

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

Процедура ЗаполнитьСнимок(ДокументОбъект, Лимит, Задолженность, ПревышениеСуммы)

	ДокументОбъект.БНС_ДолгНаМоментПроверки  = Задолженность.Долг;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки = Лимит.ЛимитСуммы;
	ДокументОбъект.БНС_ПревышениеСуммы       = ПревышениеСуммы;
	ДокументОбъект.БНС_МаксПросрочкаДней     = Задолженность.МаксПросрочкаДней;
	ДокументОбъект.БНС_ПрименимыйЛимит       = Лимит.Лимит;

КонецПроцедуры

Процедура ОчиститьСнимок(ДокументОбъект)

	ДокументОбъект.БНС_ДолгНаМоментПроверки  = 0;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки = 0;
	ДокументОбъект.БНС_ПревышениеСуммы       = 0;
	ДокументОбъект.БНС_МаксПросрочкаДней     = 0;
	ДокументОбъект.БНС_ПрименимыйЛимит       = Справочники.БНС_ЛимитыВзаиморасчетов.ПустаяСсылка();

КонецПроцедуры

Функция СуммаДокументаДляКонтроля(ДокументОбъект) Экспорт

	Если ДокументОбъект.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
		Возврат ДокументОбъект.СуммаДокумента;
	КонецЕсли;

	Возврат 0;

КонецФункции
Функция КонтрагентПартнера(Партнер) Экспорт

	Результат = Справочники.Контрагенты.ПустаяСсылка();

	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Партнер = &Партнер
		|	И НЕ Контрагенты.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Наименование";
		Запрос.УстановитьПараметр("Партнер", Партнер);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Контрагент;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

