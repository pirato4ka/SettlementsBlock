#Область ПрограммныйИнтерфейс

// Проверяет лимиты дебиторской задолженности при проведении отгрузочного документа.
// В режиме правила "Запретить" устанавливает Отказ, в режиме "Предупредить" только
// предупреждает пользователя и оставляет статус "На проверке".
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг
//                - Проверяемый документ.
//  Отказ - Булево - Признак отказа в проведении. Устанавливается процедурой.
//
Процедура ПроверитьПередОтгрузкой(ДокументОбъект, Отказ) Экспорт

	Попытка

		Если Не БНС_ОбщегоНазначения.ИспользоватьФинансовыйКонтроль() Тогда
			Возврат;
		КонецЕсли;

		Если ДокументОбъект.ОбменДанными.Загрузка ИЛИ ДокументОбъект.ПометкаУдаления Тогда
			Возврат;
		КонецЕсли;

		Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;

		Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена Тогда
			Отказ = Истина;
			Текст = ТекстОтказаКонтролера(ДокументОбъект);
			БНС_ОбщегоНазначения.ЗафиксироватьОтказ(ДокументОбъект, Текст);
			БНС_ОбщегоНазначения.ВывестиСообщение(Текст, ДокументОбъект);
			Возврат;
		КонецЕсли;

		// Решение контролера "Отгрузка разрешена" отменяет проверку лимитов.
		Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена Тогда
			Возврат;
		КонецЕсли;

		Результат = РассчитатьКонтроль(ДокументОбъект);
		ПрименитьРезультат(ДокументОбъект, Результат, Отказ);

	Исключение
		// Сбой контроля не должен превращаться в разрешение на отгрузку.
		Отказ = Истина;
		ОписаниеСбоя = "Не удалось выполнить финансовый контроль. Проведение запрещено. "
			+ ОписаниеОшибки();
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(ДокументОбъект, ОписаниеСбоя);
		БНС_ОбщегоНазначения.ВывестиСообщение(ОписаниеСбоя, ДокументОбъект);
	КонецПопытки;

КонецПроцедуры

// Оценивает лимиты при обычной записи документа (не при проведении).
// Запись не блокируется: заполняется только статус и снимок проверки, чтобы
// непроведенный документ с превышением был виден контролеру.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг
//                - Записываемый документ.
//
Процедура ЗаполнитьСтатусПриЗаписи(ДокументОбъект) Экспорт

	Попытка

		Если Не БНС_ОбщегоНазначения.ИспользоватьФинансовыйКонтроль() Тогда
			Возврат;
		КонецЕсли;

		Если ДокументОбъект.ОбменДанными.Загрузка ИЛИ ДокументОбъект.ПометкаУдаления Тогда
			Возврат;
		КонецЕсли;

		Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;

		Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
			ИЛИ ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена Тогда
			Возврат;
		КонецЕсли;

		Результат = РассчитатьКонтроль(ДокументОбъект);
		ПрименитьРезультат(ДокументОбъект, Результат, Ложь);

	Исключение
		// Запись документа не должна падать из-за контроля, сбой только фиксируется.
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(ДокументОбъект, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Рассчитывает состояние финансового контроля документа на его дату.
// Используется при проведении, при записи и при фиксации решения контролера.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг
//                - Проверяемый документ.
//
// Возвращаемое значение:
//  Структура - Результат проверки:
//   * Применим - Булево - Найден лимит, действующий на дату документа.
//   * Лимит - Структура, Неопределено - Версия правила, примененная к документу.
//   * Задолженность - Структура - Долг и просрочка покупателя на дату проверки.
//   * СуммаДокумента - Число - Сумма проверяемого документа.
//   * ПрогнозныйДолг - Число - Долг с учетом проверяемого документа.
//   * ПревышениеСуммы - Число - На сколько прогнозный долг больше лимита.
//   * ПревышениеСрока - Число - На сколько дней просрочка больше допустимой.
//   * ЕстьНарушение - Булево - Превышен лимит по сумме или по сроку.
//   * Текст - Строка - Расшифровка нарушения для пользователя.
//
Функция РассчитатьКонтроль(ДокументОбъект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Применим", Ложь);
	Результат.Вставить("Лимит", Неопределено);
	Результат.Вставить("Задолженность", Неопределено);
	Результат.Вставить("СуммаДокумента", 0);
	Результат.Вставить("ПрогнозныйДолг", 0);
	Результат.Вставить("ПревышениеСуммы", 0);
	Результат.Вставить("ПревышениеСрока", 0);
	Результат.Вставить("ЕстьНарушение", Ложь);
	Результат.Вставить("Текст", "");

	МоментПроверки = КонецДня(ДокументОбъект.Дата);
	Партнер       = ЗначениеРеквизитаДокумента(ДокументОбъект, "Партнер");
	Контрагент    = ЗначениеРеквизитаДокумента(ДокументОбъект, "Контрагент");
	Организация   = ЗначениеРеквизитаДокумента(ДокументОбъект, "Организация");

	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;

	Лимит = ЛимитНаДату(Партнер, Контрагент, Организация, МоментПроверки);
	Если Лимит = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Применим = Истина;
	Результат.Лимит = Лимит;

	Задолженность = ЗадолженностьНаДату(Партнер, Контрагент, Лимит.ОбъектКонтроля,
		Лимит.Организация, МоментПроверки, ДокументОбъект.Ссылка);
	Результат.Задолженность = Задолженность;

	Результат.СуммаДокумента = СуммаДокументаДляКонтроля(ДокументОбъект);
	Результат.ПрогнозныйДолг = Задолженность.Долг + Результат.СуммаДокумента;

	// Нулевой лимит по сумме трактуется как "контроль по сумме не задан".
	Если Лимит.ЛимитСуммы > 0 Тогда
		Результат.ПревышениеСуммы = Макс(0, Результат.ПрогнозныйДолг - Лимит.ЛимитСуммы);
	КонецЕсли;

	Результат.ПревышениеСрока = Макс(0, Задолженность.МаксПросрочкаДней
		- Лимит.ДопустимаяПросрочкаДней);

	Результат.ЕстьНарушение = Результат.ПревышениеСуммы > 0
		ИЛИ Результат.ПревышениеСрока > 0;

	Если Результат.ЕстьНарушение Тогда
		Результат.Текст = ТекстНарушения(ДокументОбъект, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выбирает версию лимита, действующую на момент проверки.
// Приоритет: правило на партнера важнее правила на контрагента, правило
// с конкретной организацией важнее правила "все организации".
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  Контрагент - СправочникСсылка.Контрагенты - Контрагент документа (может быть пустым).
//  Организация - СправочникСсылка.Организации - Организация документа.
//  МоментПроверки - Дата - Момент, на который подбирается версия лимита.
//
// Возвращаемое значение:
//  Структура, Неопределено - Версия лимита либо Неопределено, если правил нет.
//
Функция ЛимитНаДату(Партнер, Контрагент, Организация, МоментПроверки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Лимит КАК Лимит,
	|	Значения.ОбъектКонтроля КАК ОбъектКонтроля,
	|	Значения.Организация КАК Организация,
	|	Значения.Период КАК Период,
	|	Значения.ЛимитСуммы КАК ЛимитСуммы,
	|	Значения.Валюта КАК Валюта,
	|	Значения.ДопустимаяПросрочкаДней КАК ДопустимаяПросрочкаДней,
	|	Значения.ДействиеПриНарушении КАК ДействиеПриНарушении,
	|	Значения.ДействуетПо КАК ДействуетПо
	|ИЗ
	|	РегистрСведений.БНС_ЗначенияЛимитов.СрезПоследних(&МоментПроверки) КАК Значения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БНС_ЛимитыВзаиморасчетов КАК Правило
	|		ПО Значения.Лимит = Правило.Ссылка
	|ГДЕ
	|	Значения.Активна
	|	И НЕ Правило.ПометкаУдаления
	|	И (Значения.ОбъектКонтроля = &Партнер
	|		ИЛИ Значения.ОбъектКонтроля = &Контрагент)
	|	И (Значения.Организация = &Организация
	|		ИЛИ Значения.Организация = &ПустаяОрганизация)
	|	И (Значения.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Значения.ДействуетПо >= &НачалоДня)";

	Запрос.УстановитьПараметр("МоментПроверки", МоментПроверки);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(МоментПроверки));
	Запрос.УстановитьПараметр("Партнер", ?(ЗначениеЗаполнено(Партнер), Партнер,
		Справочники.Партнеры.ПустаяСсылка()));
	Запрос.УстановитьПараметр("Контрагент", ?(ЗначениеЗаполнено(Контрагент), Контрагент,
		Справочники.Контрагенты.ПустаяСсылка()));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ПустаяОрганизация", Справочники.Организации.ПустаяСсылка());

	Выборка = Запрос.Выполнить().Выбрать();

	Лучший = Неопределено;
	ЛучшийБалл = 100;

	Пока Выборка.Следующий() Цикл

		БаллОбъекта = ПриоритетОбъектаКонтроля(Выборка.ОбъектКонтроля, Партнер, Контрагент);
		Если БаллОбъекта = 0 Тогда
			// Правило относится к другому объекту контроля, применить его нельзя.
			Продолжить;
		КонецЕсли;

		Балл = БаллОбъекта * 10 + ?(Выборка.Организация = Организация, 0, 1);

		Если Балл < ЛучшийБалл Тогда
			ЛучшийБалл = Балл;
			Лучший = Новый Структура("Лимит, ОбъектКонтроля, Организация, Период, ДействуетПо,
				|ЛимитСуммы, Валюта, ДопустимаяПросрочкаДней, ДействиеПриНарушении");
			ЗаполнитьЗначенияСвойств(Лучший, Выборка);
		КонецЕсли;

	КонецЦикла;

	Если Лучший <> Неопределено Тогда
		Лучший.ЛимитСуммы = ПересчитатьВВалютуУчета(Лучший.ЛимитСуммы, Лучший.Валюта,
			МоментПроверки);
	КонецЕсли;

	Возврат Лучший;

КонецФункции

// Возвращает приоритет правила для документа: 1 - правило на партнера,
// 2 - правило на контрагента, 0 - правило к документу не относится.
//
// Параметры:
//  ОбъектКонтроля - СправочникСсылка.Партнеры, СправочникСсылка.Контрагенты - Объект контроля правила.
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  Контрагент - СправочникСсылка.Контрагенты - Контрагент документа.
//
// Возвращаемое значение:
//  Число - Приоритет правила.
//
Функция ПриоритетОбъектаКонтроля(ОбъектКонтроля, Партнер, Контрагент) Экспорт

	Если Не ЗначениеЗаполнено(ОбъектКонтроля) Тогда
		Возврат 0;
	КонецЕсли;

	Если ЗначениеЗаполнено(Партнер) И ОбъектКонтроля = Партнер Тогда
		Возврат 1;
	КонецЕсли;

	Если ЗначениеЗаполнено(Контрагент) И ОбъектКонтроля = Контрагент Тогда
		Возврат 2;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Считает дебиторскую задолженность покупателя на момент проверки.
// Если правило задано на контрагента, долг ограничивается этим контрагентом,
// если организация правила заполнена - только этой организацией.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  Контрагент - СправочникСсылка.Контрагенты - Контрагент документа.
//  ОбъектКонтроля - СправочникСсылка.Партнеры, СправочникСсылка.Контрагенты - Объект контроля правила.
//  ОрганизацияЛимита - СправочникСсылка.Организации - Организация правила (пустая - все организации).
//  МоментПроверки - Дата - Момент расчета задолженности.
//  РегистраторДляИсключения - ДокументСсылка, Неопределено - Документ, движения которого
//                            уже записаны в регистр и не должны учитываться повторно.
//
// Возвращаемое значение:
//  Структура - Долг и расшифровка просрочки:
//   * Долг - Число - Сумма дебиторской задолженности.
//   * МаксПросрочкаДней - Число - Максимальная просрочка по документам расчетов.
//   * ДокументПросрочки - ДокументСсылка, Неопределено - Накладная с максимальной просрочкой.
//   * СуммаПросрочки - Число - Долг по этой накладной.
//   * Расшифровка - ТаблицаЗначений - Долг по документам расчетов с просрочкой.
//
Функция ЗадолженностьНаДату(Партнер, Контрагент, ОбъектКонтроля, ОрганизацияЛимита,
	МоментПроверки, РегистраторДляИсключения = Неопределено) Экспорт

	Результат = Новый Структура("Долг, МаксПросрочкаДней, ДокументПросрочки, СуммаПросрочки, Расшифровка",
		0, 0, Неопределено, 0, Новый ТаблицаЗначений);

	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;

	МетаданныеРегистра = Метаданные.РегистрыНакопления.Найти("РасчетыСПокупателями");
	Если МетаданныеРегистра = Неопределено Тогда
		ВызватьИсключение "В конфигурации не найден регистр накопления ""РасчетыСПокупателями""."
			+ " Расширение требуется адаптировать под фактическую схему взаиморасчетов УТ.";
	КонецЕсли;

	ИмяРесурса = ИмяРесурсаОстатка(МетаданныеРегистра);
	ЕстьИзмерениеКонтрагент = МетаданныеРегистра.Измерения.Найти("Контрагент") <> Неопределено;
	ЕстьИзмерениеОрганизация = МетаданныеРегистра.Измерения.Найти("Организация") <> Неопределено;
	ЕстьИзмерениеВалюта = МетаданныеРегистра.Измерения.Найти("Валюта") <> Неопределено;
	ИмяИзмеренияДокумента = ИмяИзмеренияДокументаРасчетов(МетаданныеРегистра);

	// Долг считается по контрагенту, если правило задано на контрагента.
	ОграничитьПоКонтрагенту = ОбъектКонтроля = Контрагент
		И ЗначениеЗаполнено(Контрагент) И ЕстьИзмерениеКонтрагент;

	// Условия виртуальной таблицы остатков записываются без псевдонима таблицы.
	Условия = Новый Массив;
	Условия.Добавить("Партнер = &Партнер");
	Если ОграничитьПоКонтрагенту Тогда
		Условия.Добавить("Контрагент = &Контрагент");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОрганизацияЛимита) И ЕстьИзмерениеОрганизация Тогда
		Условия.Добавить("Организация = &Организация");
	КонецЕсли;
	УсловиеОстатков = СтрСоединить(Условия, " И ");

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Партнер", Партнер);
	ПараметрыЗапроса.Вставить("Контрагент", ?(ЗначениеЗаполнено(Контрагент), Контрагент,
		Справочники.Контрагенты.ПустаяСсылка()));
	ПараметрыЗапроса.Вставить("Организация", ?(ЗначениеЗаполнено(ОрганизацияЛимита),
		ОрганизацияЛимита, Справочники.Организации.ПустаяСсылка()));
	ПараметрыЗапроса.Вставить("Момент", МоментПроверки);

	Если ЕстьИзмерениеВалюта Тогда
		ВыбираемыеПоля = "Расчеты.Валюта КАК Валюта,"
			+ Символы.ПС + Символы.Таб + "ЕСТЬNULL(СУММА(Расчеты." + ИмяРесурса
			+ "Остаток), 0) КАК Остаток";
		Группировка = Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб + "Расчеты.Валюта";
	Иначе
		ВыбираемыеПоля = "ЕСТЬNULL(СУММА(Расчеты." + ИмяРесурса + "Остаток), 0) КАК Остаток";
		Группировка = "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|" + Символы.Таб + ВыбираемыеПоля + "
	|ИЗ
	|" + Символы.Таб + "РегистрНакопления.РасчетыСПокупателями.Остатки(&Момент, "
	+ УсловиеОстатков + ") КАК Расчеты" + Группировка;

	УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса);

	Выборка = Запрос.Выполнить().Выбрать();
	Долг = 0;
	Пока Выборка.Следующий() Цикл
		Валюта = ?(ЕстьИзмерениеВалюта, Выборка.Валюта, Неопределено);
		Долг = Долг + ПересчитатьВВалютуУчета(Выборка.Остаток, Валюта, МоментПроверки);
	КонецЦикла;

	// При проведении документ уже записал движения, поэтому его собственный вклад
	// вычитается: иначе сумма документа учитывалась бы в долге дважды.
	Если ЗначениеЗаполнено(РегистраторДляИсключения) Тогда
		Долг = Долг - ДолгПоРегистратору(РегистраторДляИсключения, УсловиеОстатков,
			ПараметрыЗапроса, ИмяРесурса, ЕстьИзмерениеВалюта, МоментПроверки);
	КонецЕсли;

	// Отрицательное сальдо (аванс покупателя) уменьшает долг, но не становится долгом.
	Результат.Долг = Макс(0, Долг);

	Если ИмяИзмеренияДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Расшифровка просрочки по накладным: измерение документа расчетов есть в этой версии УТ.
	ЗапросРасшифровки = Новый Запрос;
	ЗапросРасшифровки.Текст =
	"ВЫБРАТЬ
	|	Расчеты." + ИмяИзмеренияДокумента + " КАК ДокументРасчетов,
	|	ЕСТЬNULL(СУММА(Расчеты." + ИмяРесурса + "Остаток), 0) КАК ОстатокДолга
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(&Момент, " + УсловиеОстатков + ") КАК Расчеты
	|ГДЕ
	|	Расчеты." + ИмяИзмеренияДокумента + " <> НЕОПРЕДЕЛЕНО
	|СГРУППИРОВАТЬ ПО
	|	Расчеты." + ИмяИзмеренияДокумента + "
	|ИМЕЮЩИЕ
	|	СУММА(Расчеты." + ИмяРесурса + "Остаток) > 0";

	УстановитьПараметрыЗапроса(ЗапросРасшифровки, ПараметрыЗапроса);

	Расшифровка = Новый ТаблицаЗначений;
	Расшифровка.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка"));
	Расшифровка.Колонки.Добавить("ДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	Расшифровка.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(15, 2)));
	Расшифровка.Колонки.Добавить("СрокОплаты", Новый ОписаниеТипов("Дата"));
	Расшифровка.Колонки.Добавить("ДнейПросрочки", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(9, 0)));

	ВыборкаРасшифровки = ЗапросРасшифровки.Выполнить().Выбрать();

	Пока ВыборкаРасшифровки.Следующий() Цикл

		Если Не ЗначениеЗаполнено(ВыборкаРасшифровки.ДокументРасчетов) Тогда
			Продолжить;
		КонецЕсли;

		ДатаОтгрузки = ВыборкаРасшифровки.ДокументРасчетов.Дата;
		СрокОплаты = КонецДня(ДатаОтгрузки + ОтсрочкаПоДоговору(
			ВыборкаРасшифровки.ДокументРасчетов) * 86400);
		ДнейПросрочки = Макс(0, (НачалоДня(МоментПроверки) - НачалоДня(СрокОплаты)) / 86400);

		СтрокаРасшифровки = Расшифровка.Добавить();
		СтрокаРасшифровки.Документ       = ВыборкаРасшифровки.ДокументРасчетов;
		СтрокаРасшифровки.ДатаОтгрузки    = ДатаОтгрузки;
		СтрокаРасшифровки.Сумма           = ВыборкаРасшифровки.ОстатокДолга;
		СтрокаРасшифровки.СрокОплаты      = СрокОплаты;
		СтрокаРасшифровки.ДнейПросрочки   = ДнейПросрочки;

		Если ДнейПросрочки > Результат.МаксПросрочкаДней Тогда
			Результат.МаксПросрочкаДней = ДнейПросрочки;
			Результат.ДокументПросрочки = ВыборкаРасшифровки.ДокументРасчетов;
			Результат.СуммаПросрочки    = ВыборкаРасшифровки.ОстатокДолга;
		КонецЕсли;

	КонецЦикла;

	Расшифровка.Сортировать("ДнейПросрочки УБЫВ");
	Результат.Расшифровка = Расшифровка;

	Возврат Результат;

КонецФункции

// Возвращает сумму движений конкретного документа по регистру взаиморасчетов.
// Используется, чтобы не учитывать дважды документ, который при проведении уже
// записал движения до вызова контроля.
//
// Параметры:
//  Регистратор - ДокументСсылка - Документ, движения которого нужно вычесть.
//  УсловиеОтбора - Строка - Отбор по измерениям регистра без псевдонима таблицы.
//  ПараметрыЗапроса - Структура - Значения параметров отбора.
//  ИмяРесурса - Строка - Имя ресурса суммы долга.
//  ЕстьИзмерениеВалюта - Булево - Признак валютного измерения регистра.
//  МоментПроверки - Дата - Дата пересчета валюты.
//
// Возвращаемое значение:
//  Число - Сумма движений документа в валюте учета.
//
Функция ДолгПоРегистратору(Регистратор, УсловиеОтбора, ПараметрыЗапроса, ИмяРесурса,
	ЕстьИзмерениеВалюта, МоментПроверки)

	СуммаДвижения = "ВЫБОР КОГДА Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)"
		+ " ТОГДА Расчеты." + ИмяРесурса + " ИНАЧЕ -Расчеты." + ИмяРесурса + " КОНЕЦ";

	Если ЕстьИзмерениеВалюта Тогда
		ВыбираемыеПоля = "Расчеты.Валюта КАК Валюта,"
			+ Символы.ПС + Символы.Таб + "СУММА(" + СуммаДвижения + ") КАК Остаток";
		Группировка = Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
			+ "Расчеты.Валюта";
	Иначе
		ВыбираемыеПоля = "СУММА(" + СуммаДвижения + ") КАК Остаток";
		Группировка = "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|" + Символы.Таб + ВыбираемыеПоля + "
	|ИЗ
	|" + Символы.Таб + "РегистрНакопления.РасчетыСПокупателями КАК Расчеты
	|ГДЕ
	|" + Символы.Таб + "Расчеты.Активность
	|" + Символы.Таб + "И Расчеты.Регистратор = &Регистратор
	|" + Символы.Таб + "И " + УсловиеОтбора + Группировка;

	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса);

	Долг = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Валюта = ?(ЕстьИзмерениеВалюта, Выборка.Валюта, Неопределено);
		Долг = Долг + ПересчитатьВВалютуУчета(Выборка.Остаток, Валюта, МоментПроверки);
	КонецЦикла;

	Возврат Долг;

КонецФункции

// Возвращает отсрочку оплаты по договору документа в календарных днях.
// Версии УТ хранят срок оплаты в договоре; имя реквизита проверяется по метаданным,
// чтобы расширение не зависело от конкретной доработки конфигурации.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - Документ расчетов.
//
// Возвращаемое значение:
//  Число - Отсрочка в днях (0, если условия оплаты не заданы).
//
Функция ОтсрочкаПоДоговору(ДокументСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	МетаданныеДокумента = ДокументСсылка.Метаданные();
	Если МетаданныеДокумента.Реквизиты.Найти("Договор") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Договор = ДокументСсылка["Договор"];
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат 0;
	КонецЕсли;

	ИменаРеквизитов = СтрРазделить("ОтсрочкаОплаты,ОтсрочкаОплатыДней,СрокОплатыДней,ОтсрочкаДней",
		",", Ложь);

	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если Договор.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Договор[ИмяРеквизита];
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Макс(0, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Пересчитывает сумму из валюты в валюту учета по курсу на дату.
// Если валюта не задана или курс не найден, сумма возвращается без изменений:
// контроль продолжает работать и не блокирует отгрузки из-за отсутствия курса.
//
// Параметры:
//  Сумма - Число - Пересчитываемая сумма.
//  Валюта - СправочникСсылка.Валюты, Неопределено - Валюта суммы.
//  ДатаПроверки - Дата - Дата, на которую берется курс.
//
// Возвращаемое значение:
//  Число - Сумма в валюте учета.
//
Функция ПересчитатьВВалютуУчета(Сумма, Валюта, ДатаПроверки) Экспорт

	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Возврат Сумма;
	КонецЕсли;

	Если Метаданные.РегистрыСведений.Найти("КурсыВалют") = Неопределено Тогда
		Возврат Сумма;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Курсы.Курс КАК Курс,
	|	Курсы.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаПроверки, Валюта = &Валюта) КАК Курсы";
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("Валюта", Валюта);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() ИЛИ Выборка.Кратность <= 0 Тогда
		Возврат Сумма;
	КонецЕсли;

	Возврат Сумма * Выборка.Курс / Выборка.Кратность;

КонецФункции

// Возвращает сумму документа для контроля.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//
// Возвращаемое значение:
//  Число - Сумма документа.
//
Функция СуммаДокументаДляКонтроля(ДокументОбъект) Экспорт

	Если ДокументОбъект.Метаданные().Реквизиты.Найти("СуммаДокумента") = Неопределено Тогда
		ВызватьИсключение "В документе " + ДокументОбъект.Метаданные().ПолноеИмя()
			+ " не найден реквизит ""СуммаДокумента"". Проверьте адаптацию расширения.";
	КонецЕсли;

	Возврат ДокументОбъект.СуммаДокумента;

КонецФункции

// Записывает версию настроек лимита в периодический регистр сведений.
// Вызывается при записи элемента справочника "Лимиты взаиморасчетов": старые
// версии остаются в регистре и применяются к документам, проведенным задним числом.
//
// Параметры:
//  ЛимитОбъект - СправочникОбъект.БНС_ЛимитыВзаиморасчетов - Записываемый элемент справочника.
//  Отказ - Булево - Признак отказа в записи элемента справочника.
//
Процедура ЗаписатьВерсиюЛимита(ЛимитОбъект, Отказ = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(ЛимитОбъект.ОбъектКонтроля) Тогда
		// Правило без объекта контроля не применяется, запись не блокируется.
		Возврат;
	КонецЕсли;

	Попытка

		ПериодВерсии = ?(ЗначениеЗаполнено(ЛимитОбъект.ДействуетС),
			НачалоДня(ЛимитОбъект.ДействуетС), НачалоДня(ТекущаяДатаСеанса()));

		Запись = РегистрыСведений.БНС_ЗначенияЛимитов.СоздатьМенеджерЗаписи();
		Запись.Период                    = ПериодВерсии;
		Запись.Лимит                     = ЛимитОбъект.Ссылка;
		Запись.ОбъектКонтроля            = ЛимитОбъект.ОбъектКонтроля;
		Запись.Организация               = ЛимитОбъект.Организация;
		Запись.ЛимитСуммы                = ЛимитОбъект.ЛимитСуммы;
		Запись.Валюта                    = ЛимитОбъект.Валюта;
		Запись.ДопустимаяПросрочкаДней   = ЛимитОбъект.ДопустимаяПросрочкаДней;
		Запись.ДействиеПриНарушении      = ДействиеПриНарушенииПравила(ЛимитОбъект);
		Запись.ДействуетПо               = ЛимитОбъект.ДействуетПо;
		Запись.Активна                   = ЛимитОбъект.Активна И Не ЛимитОбъект.ПометкаУдаления;
		Запись.Комментарий               = ЛимитОбъект.Комментарий;
		Запись.Автор                     = Пользователи.АвторизованныйПользователь();
		Запись.Записать(Истина);

	Исключение
		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Не удалось записать версию лимита: " + ОписаниеОшибки(), ЛимитОбъект);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет статус документа и снимок проверки, при необходимости отказывает в проведении.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Результат - Структура - Результат расчета контроля.
//  Отказ - Булево - Признак отказа в проведении.
//
Процедура ПрименитьРезультат(ДокументОбъект, Результат, Отказ)

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;
	СтарыйСтатус = ДокументОбъект.БНС_СтатусФинансовогоКонтроля;
	НовыйСтатус = Статусы.Пусто;

	Если Не Результат.Применим Тогда
		ОчиститьСнимок(ДокументОбъект);
	Иначе
		ЗаполнитьСнимок(ДокументОбъект, Результат);
		Если Результат.ЕстьНарушение Тогда
			НовыйСтатус = Статусы.НаПроверке;
		КонецЕсли;
	КонецЕсли;

	ДокументОбъект.БНС_СтатусФинансовогоКонтроля = НовыйСтатус;

	Если Не Результат.Применим Тогда
		Возврат;
	КонецЕсли;

	Если Результат.ЕстьНарушение Тогда
		Если Результат.Лимит.ДействиеПриНарушении
			= Перечисления.БНС_ДействияПриНарушении.Запретить Тогда
			Отказ = Истина;
			БНС_ОбщегоНазначения.ЗафиксироватьОтказ(ДокументОбъект, Результат.Текст);
		КонецЕсли;
		БНС_ОбщегоНазначения.ВывестиСообщение(Результат.Текст, ДокументОбъект);
	КонецЕсли;

	Если Результат.ЕстьНарушение ИЛИ НовыйСтатус <> СтарыйСтатус Тогда
		БНС_ОбщегоНазначения.ЗаписатьИсторию(ДокументОбъект, НовыйСтатус, Результат);
	КонецЕсли;

КонецПроцедуры

// Заполняет снимок проверки в реквизитах документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Результат - Структура - Результат расчета контроля.
//
Процедура ЗаполнитьСнимок(ДокументОбъект, Результат)

	ДокументОбъект.БНС_ДолгНаМоментПроверки  = Результат.Задолженность.Долг;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки = Результат.Лимит.ЛимитСуммы;
	ДокументОбъект.БНС_ПревышениеСуммы       = Результат.ПревышениеСуммы;
	ДокументОбъект.БНС_МаксПросрочкаДней     = Результат.Задолженность.МаксПросрочкаДней;
	ДокументОбъект.БНС_ПрименимыйЛимит       = Результат.Лимит.Лимит;

КонецПроцедуры

// Очищает снимок проверки в реквизитах документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//
Процедура ОчиститьСнимок(ДокументОбъект)

	ДокументОбъект.БНС_ДолгНаМоментПроверки  = 0;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки = 0;
	ДокументОбъект.БНС_ПревышениеСуммы       = 0;
	ДокументОбъект.БНС_МаксПросрочкаДней     = 0;
	ДокументОбъект.БНС_ПрименимыйЛимит       = Справочники.БНС_ЛимитыВзаиморасчетов.ПустаяСсылка();

КонецПроцедуры

// Формирует текст расшифровки нарушения для пользователя.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Результат - Структура - Результат расчета контроля.
//
// Возвращаемое значение:
//  Строка - Текст сообщения.
//
Функция ТекстНарушения(ДокументОбъект, Результат)

	Лимит = Результат.Лимит;
	Задолженность = Результат.Задолженность;
	Текст = Новый Массив;

	Текст.Добавить("Финансовый контроль: лимит дебиторской задолженности превышен.");
	Текст.Добавить("Правило: " + Строка(Лимит.Лимит)
		+ " (версия от " + Формат(Лимит.Период, "ДЛФ=D") + ")");
	Текст.Добавить("Долг покупателя на " + Формат(ДокументОбъект.Дата, "ДЛФ=D") + ": "
		+ Формат(Задолженность.Долг, "ЧДЦ=2; ЧН=")
		+ ", сумма документа: " + Формат(Результат.СуммаДокумента, "ЧДЦ=2; ЧН="));
	Текст.Добавить("Прогнозный долг: " + Формат(Результат.ПрогнозныйДолг, "ЧДЦ=2; ЧН=")
		+ ", лимит: " + Формат(Лимит.ЛимитСуммы, "ЧДЦ=2; ЧН="));

	Если Результат.ПревышениеСуммы > 0 Тогда
		Текст.Добавить("Превышение лимита на сумму: "
			+ Формат(Результат.ПревышениеСуммы, "ЧДЦ=2; ЧН="));
	КонецЕсли;

	Если Результат.ПревышениеСрока > 0 Тогда
		Текст.Добавить("Просрочка сверх допустимой (" + Формат(Лимит.ДопустимаяПросрочкаДней,
			"ЧГ=0") + " дн.):");

		Для Каждого СтрокаРасшифровки Из Задолженность.Расшифровка Цикл
			Если СтрокаРасшифровки.ДнейПросрочки <= Лимит.ДопустимаяПросрочкаДней Тогда
				Продолжить;
			КонецЕсли;
			Текст.Добавить(" - " + Строка(СтрокаРасшифровки.Документ)
				+ " от " + Формат(СтрокаРасшифровки.ДатаОтгрузки, "ДЛФ=D")
				+ " на сумму " + Формат(СтрокаРасшифровки.Сумма, "ЧДЦ=2; ЧН=")
				+ ", просрочка " + Формат(СтрокаРасшифровки.ДнейПросрочки, "ЧГ=0") + " дн.");
		КонецЦикла;

		Если Задолженность.Расшифровка.Количество() = 0 Тогда
			Текст.Добавить(" - просроченные документы не детализированы:"
				+ " в регистре взаиморасчетов нет измерения документа расчетов.");
		КонецЕсли;
	КонецЕсли;

	Если Лимит.ДействиеПриНарушении = Перечисления.БНС_ДействияПриНарушении.Запретить Тогда
		Текст.Добавить("Действие: проведение запрещено. Отгрузку может разрешить контролер"
			+ " кнопкой ""Разрешить отгрузку"".");
	Иначе
		Текст.Добавить("Действие: предупреждение. Документ проводится со статусом ""На проверке"".");
	КонецЕсли;

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

// Возвращает действие при нарушении для записываемой версии лимита.
// Мягкий режим подставляется по умолчанию: подсистема вводится поэтапно.
//
// Параметры:
//  ЛимитОбъект - СправочникОбъект.БНС_ЛимитыВзаиморасчетов - Элемент справочника.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.БНС_ДействияПриНарушении - Действие при нарушении.
//
Функция ДействиеПриНарушенииПравила(ЛимитОбъект)

	Если ЗначениеЗаполнено(ЛимитОбъект.ДействиеПриНарушении) Тогда
		Возврат ЛимитОбъект.ДействиеПриНарушении;
	КонецЕсли;

	Возврат Перечисления.БНС_ДействияПриНарушении.Предупредить;

КонецФункции

// Формирует текст сообщения при запрете отгрузки контролером.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//
// Возвращаемое значение:
//  Строка - Текст сообщения.
//
Функция ТекстОтказаКонтролера(ДокументОбъект)

	Текст = "Отгрузка по документу запрещена контролером финансового контроля";

	Если ЗначениеЗаполнено(ДокументОбъект.БНС_РазрешилОтгрузку) Тогда
		Текст = Текст + " (" + Строка(ДокументОбъект.БНС_РазрешилОтгрузку) + ")";
	КонецЕсли;

	Если ЗначениеЗаполнено(ДокументОбъект.БНС_ДатаРазрешения) Тогда
		Текст = Текст + " " + Формат(ДокументОбъект.БНС_ДатаРазрешения, "ДЛФ=DT");
	КонецЕсли;

	Текст = Текст + ".";

	Если ЗначениеЗаполнено(ДокументОбъект.БНС_КомментарийКонтролера) Тогда
		Текст = Текст + " Комментарий: " + ДокументОбъект.БНС_КомментарийКонтролера;
	КонецЕсли;

	Возврат Текст + Символы.ПС + "Документ можно сохранить без проведения.";

КонецФункции

// Возвращает имя ресурса регистра, по которому строится остаток долга.
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданныхРегистрНакопления - Метаданные регистра взаиморасчетов.
//
// Возвращаемое значение:
//  Строка - Имя ресурса.
//
Функция ИмяРесурсаОстатка(МетаданныеРегистра)

	Для Каждого ИмяРесурса Из СтрРазделить("СуммаРасчетов,Сумма,СуммаДолга", ",", Ложь) Цикл
		Если МетаданныеРегистра.Ресурсы.Найти(ИмяРесурса) <> Неопределено Тогда
			Возврат ИмяРесурса;
		КонецЕсли;
	КонецЦикла;

	Если МетаданныеРегистра.Ресурсы.Количество() = 1 Тогда
		Возврат МетаданныеРегистра.Ресурсы.Получить(0).Имя;
	КонецЕсли;

	ВызватьИсключение "Не удалось определить ресурс долга регистра "
		+ МетаданныеРегистра.Имя + ". Расширение требуется адаптировать под схему УТ.";

КонецФункции

// Возвращает имя измерения регистра, в котором хранится документ расчетов.
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданныхРегистрНакопления - Метаданные регистра взаиморасчетов.
//
// Возвращаемое значение:
//  Строка, Неопределено - Имя измерения либо Неопределено, если измерения нет.
//
Функция ИмяИзмеренияДокументаРасчетов(МетаданныеРегистра)

	Для Каждого ИмяИзмерения Из СтрРазделить(
		"ДокументРасчетовСКонтрагентом,ДокументРасчетов,Документ", ",", Ложь) Цикл
		Если МетаданныеРегистра.Измерения.Найти(ИмяИзмерения) <> Неопределено Тогда
			Возврат ИмяИзмерения;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает значение реквизита документа либо Неопределено, если реквизита нет.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  ИмяРеквизита - Строка - Имя реквизита.
//
// Возвращаемое значение:
//  Произвольный - Значение реквизита.
//
Функция ЗначениеРеквизитаДокумента(ДокументОбъект, ИмяРеквизита)

	Если ДокументОбъект.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДокументОбъект[ИмяРеквизита];

КонецФункции

// Устанавливает параметры запроса задолженности.
//
// Параметры:
//  Запрос - Запрос - Запрос к регистру взаиморасчетов.
//  ПараметрыЗапроса - Структура - Значения параметров.
//
Процедура УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса)

	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
