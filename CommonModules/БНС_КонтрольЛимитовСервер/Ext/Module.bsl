////////////////////////////////////////////////////////////////////////////////
// БНС_КонтрольЛимитовСервер
//
// Проверка лимита дебиторской задолженности перед отгрузкой.
//
// Схема регистра накопления "РасчетыСКлиентами" (УТ 11.5):
//   измерения: АналитикаУчетаПоПартнерам, ОбъектРасчетов, Валюта;
//   ресурс суммы долга: Сумма.
// Долг считается по партнеру (измерение АналитикаУчетаПоПартнерам), расшифровка
// просрочки - по документу расчетов (измерение ОбъектРасчетов).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет лимит при проведении отгрузочного документа.
// В режиме "Запретить" устанавливает Отказ, в режиме "Предупредить" только
// предупреждает пользователя и оставляет статус "На проверке".
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг
//                - Проверяемый документ.
//  Отказ - Булево - Признак отказа в проведении. Устанавливается процедурой.
//
Процедура ПроверитьПередОтгрузкой(ДокументОбъект, Отказ) Экспорт

	Попытка

		Если Не БНС_ОбщегоНазначения.ИспользоватьФинансовыйКонтроль() Тогда
			Возврат;
		КонецЕсли;

		Если ДокументОбъект.ОбменДанными.Загрузка ИЛИ ДокументОбъект.ПометкаУдаления Тогда
			Возврат;
		КонецЕсли;

		Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;

		Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена Тогда
			Отказ = Истина;
			Текст = ТекстОтказаКонтролера(ДокументОбъект);
			БНС_ОбщегоНазначения.ЗафиксироватьОтказ(ДокументОбъект, Текст);
			БНС_ОбщегоНазначения.ВывестиСообщение(Текст, ДокументОбъект);
			Возврат;
		КонецЕсли;

		// Решение контролера "Отгрузка разрешена" отменяет проверку лимитов.
		Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена Тогда
			Возврат;
		КонецЕсли;

		Результат = РассчитатьКонтроль(ДокументОбъект);
		ПрименитьРезультат(ДокументОбъект, Результат, Отказ);

	Исключение
		// Сбой контроля не должен превращаться в разрешение на отгрузку.
		Отказ = Истина;
		ОписаниеСбоя = "Не удалось выполнить финансовый контроль. Проведение запрещено. "
			+ ОписаниеОшибки();
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(ДокументОбъект, ОписаниеСбоя);
		БНС_ОбщегоНазначения.ВывестиСообщение(ОписаниеСбоя, ДокументОбъект);
	КонецПопытки;

КонецПроцедуры

// Оценивает лимиты при обычной записи документа (не при проведении).
// Запись не блокируется: заполняется только статус и снимок проверки, чтобы
// непроведенный документ с превышением был виден контролеру.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг
//                - Записываемый документ.
//
Процедура ЗаполнитьСтатусПриЗаписи(ДокументОбъект) Экспорт

	Попытка

		Если Не БНС_ОбщегоНазначения.ИспользоватьФинансовыйКонтроль() Тогда
			Возврат;
		КонецЕсли;

		Если ДокументОбъект.ОбменДанными.Загрузка ИЛИ ДокументОбъект.ПометкаУдаления Тогда
			Возврат;
		КонецЕсли;

		Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;

		Если ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
			ИЛИ ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена Тогда
			Возврат;
		КонецЕсли;

		Результат = РассчитатьКонтроль(ДокументОбъект);
		// При обычной записи пользователя не прерываем: заполняются статус и снимок
		// проверки, полная расшифровка показывается при проведении.
		ПрименитьРезультат(ДокументОбъект, Результат, Ложь, Ложь);

	Исключение
		// Запись документа не должна падать из-за контроля, сбой только фиксируется.
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(ДокументОбъект, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Рассчитывает состояние финансового контроля документа на его дату.
// Используется при проведении, при записи и при фиксации решения контролера.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг
//                - Проверяемый документ.
//
// Возвращаемое значение:
//  Структура - Результат проверки:
//   * Применим - Булево - Найден лимит, действующий на дату документа.
//   * Лимит - Структура, Неопределено - Версия правила, примененная к документу.
//   * Задолженность - Структура - Долг и просрочка покупателя на дату проверки.
//   * СуммаДокумента - Число - Сумма проверяемого документа.
//   * ПрогнозныйДолг - Число - Долг с учетом проверяемого документа.
//   * ПревышениеСуммы - Число - На сколько прогнозный долг больше лимита.
//   * ПревышениеСрока - Число - На сколько дней просрочка больше допустимой.
//   * ЕстьНарушение - Булево - Превышен лимит по сумме или по сроку.
//   * Текст - Строка - Расшифровка нарушения для пользователя.
//
Функция РассчитатьКонтроль(ДокументОбъект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Применим", Ложь);
	Результат.Вставить("Лимит", Неопределено);
	Результат.Вставить("Задолженность", Неопределено);
	Результат.Вставить("СуммаДокумента", 0);
	Результат.Вставить("ПрогнозныйДолг", 0);
	Результат.Вставить("ПревышениеСуммы", 0);
	Результат.Вставить("ПревышениеСрока", 0);
	Результат.Вставить("ЕстьНарушение", Ложь);
	Результат.Вставить("Текст", "");

	Партнер = ДокументОбъект.Партнер;
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;

	МоментПроверки = КонецДня(ДокументОбъект.Дата);

	Лимит = ЛимитНаДату(Партнер, ДокументОбъект.Контрагент, ДокументОбъект.Организация,
		МоментПроверки);
	Если Лимит = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Применим = Истина;
	Результат.Лимит = Лимит;

	Результат.Задолженность = ЗадолженностьНаДату(Партнер, МоментПроверки,
		ДокументОбъект.Ссылка);

	Результат.СуммаДокумента = ДокументОбъект.СуммаДокумента;
	Результат.ПрогнозныйДолг = Результат.Задолженность.Долг + Результат.СуммаДокумента;

	// Нулевой лимит по сумме трактуется как "контроль по сумме не задан".
	Если Лимит.ЛимитСуммы > 0 Тогда
		Результат.ПревышениеСуммы = Макс(0, Результат.ПрогнозныйДолг - Лимит.ЛимитСуммы);
	КонецЕсли;

	Результат.ПревышениеСрока = Макс(0, Результат.Задолженность.МаксПросрочкаДней
		- Лимит.ДопустимаяПросрочкаДней);

	Результат.ЕстьНарушение = Результат.ПревышениеСуммы > 0
		ИЛИ Результат.ПревышениеСрока > 0;

	Если Результат.ЕстьНарушение Тогда
		Результат.Текст = ТекстНарушения(ДокументОбъект, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выбирает версию лимита, действующую на момент проверки.
// Приоритет: правило на партнера важнее правила на контрагента, правило
// с заполненной организацией важнее правила "все организации".
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  Контрагент - СправочникСсылка.Контрагенты - Контрагент документа.
//  Организация - СправочникСсылка.Организации - Организация документа.
//  МоментПроверки - Дата - Момент, на который подбирается версия лимита.
//
// Возвращаемое значение:
//  Структура, Неопределено - Версия лимита либо Неопределено, если правил нет.
//
Функция ЛимитНаДату(Партнер, Контрагент, Организация, МоментПроверки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Лимит КАК Лимит,
	|	Значения.ОбъектКонтроля КАК ОбъектКонтроля,
	|	Значения.Организация КАК Организация,
	|	Значения.Период КАК Период,
	|	Значения.ЛимитСуммы КАК ЛимитСуммы,
	|	Значения.Валюта КАК Валюта,
	|	Значения.ДопустимаяПросрочкаДней КАК ДопустимаяПросрочкаДней,
	|	Значения.ДействиеПриНарушении КАК ДействиеПриНарушении,
	|	Значения.ДействуетПо КАК ДействуетПо
	|ИЗ
	|	РегистрСведений.БНС_ЗначенияЛимитов.СрезПоследних(&МоментПроверки) КАК Значения
	|ГДЕ
	|	Значения.Активна
	|	И НЕ Значения.Лимит.ПометкаУдаления
	|	И (Значения.ОбъектКонтроля = &Партнер
	|			ИЛИ Значения.ОбъектКонтроля = &Контрагент)
	|	И (Значения.Организация = &Организация
	|			ИЛИ Значения.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И (Значения.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Значения.ДействуетПо >= &НачалоДня)";

	Запрос.УстановитьПараметр("МоментПроверки", МоментПроверки);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(МоментПроверки));
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Контрагент", ?(ЗначениеЗаполнено(Контрагент), Контрагент,
		Справочники.Контрагенты.ПустаяСсылка()));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	ЛучшаяВерсия = Неопределено;
	ЛучшийПриоритет = Неопределено;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ЗначениеЗаполнено(Партнер) И Выборка.ОбъектКонтроля = Партнер Тогда
			Приоритет = 1;
		ИначеЕсли ЗначениеЗаполнено(Контрагент) И Выборка.ОбъектКонтроля = Контрагент Тогда
			Приоритет = 2;
		Иначе
			Продолжить;
		КонецЕсли;

		// Правило с конкретной организацией уточняет правило "все организации".
		Если ЗначениеЗаполнено(Выборка.Организация) Тогда
			Приоритет = Приоритет + 0.5;
		КонецЕсли;

		Если ЛучшийПриоритет = Неопределено ИЛИ Приоритет < ЛучшийПриоритет Тогда
			ЛучшийПриоритет = Приоритет;
			ЛучшаяВерсия = Новый Структура("Лимит, ОбъектКонтроля, Организация, Период,
				|ЛимитСуммы, Валюта, ДопустимаяПросрочкаДней, ДействиеПриНарушении");
			ЗаполнитьЗначенияСвойств(ЛучшаяВерсия, Выборка);
		КонецЕсли;

	КонецЦикла;

	Если ЛучшаяВерсия <> Неопределено Тогда
		ЛучшаяВерсия.ЛимитСуммы = ПересчитатьВВалютуУчета(ЛучшаяВерсия.ЛимитСуммы,
			ЛучшаяВерсия.Валюта, МоментПроверки);
	КонецЕсли;

	Возврат ЛучшаяВерсия;

КонецФункции

// Считает дебиторскую задолженность партнера на момент проверки.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  МоментПроверки - Дата - Момент расчета задолженности.
//  ИсключаемыйРегистратор - ДокументСсылка, Неопределено - Документ, движения которого
//                         уже записаны в регистр и не должны учитываться повторно.
//
// Возвращаемое значение:
//  Структура - Долг и расшифровка просрочки:
//   * Долг - Число - Сумма дебиторской задолженности.
//   * МаксПросрочкаДней - Число - Максимальная просрочка по документам расчетов.
//   * ДокументПросрочки - ДокументСсылка, Неопределено - Накладная с максимальной просрочкой.
//   * СуммаПросрочки - Число - Долг по этой накладной.
//   * Расшифровка - ТаблицаЗначений - Долг по документам расчетов с просрочкой.
//
Функция ЗадолженностьНаДату(Партнер, МоментПроверки, ИсключаемыйРегистратор = Неопределено) Экспорт

	Результат = Новый Структура("Долг, МаксПросрочкаДней, ДокументПросрочки, СуммаПросрочки, Расшифровка",
		0, 0, Неопределено, 0, НоваяТаблицаРасшифровки());

	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат Результат;
	КонецЕсли;

	Долг = ДолгПартнера(Партнер, МоментПроверки);

	// Подписка на проведение вызывается после модуля объекта: движения проверяемого
	// документа уже записаны, поэтому его собственный вклад вычитается.
	Если ЗначениеЗаполнено(ИсключаемыйРегистратор) Тогда
		Долг = Долг - СуммаДвиженийДокумента(ИсключаемыйРегистратор, МоментПроверки);
	КонецЕсли;

	// Отрицательное сальдо (аванс покупателя) уменьшает долг, но не становится долгом.
	Результат.Долг = Макс(0, Долг);

	ЗаполнитьРасшифровкуПросрочки(Результат, Партнер, МоментПроверки);

	Возврат Результат;

КонецФункции

// Возвращает отсрочку оплаты по договору документа расчета в календарных днях.
// Версии УТ хранят срок оплаты в договоре; имя реквизита проверяется по метаданным,
// чтобы расширение не зависело от конкретной доработки конфигурации.
//
// Параметры:
//  ДокументРасчетов - ДокументСсылка - Документ расчетов.
//
// Возвращаемое значение:
//  Число - Отсрочка в днях (0, если условия оплаты не заданы).
//
Функция ОтсрочкаПоДоговору(ДокументРасчетов) Экспорт

	Если Не ЗначениеЗаполнено(ДокументРасчетов) Тогда
		Возврат 0;
	КонецЕсли;

	Если ДокументРасчетов.Метаданные().Реквизиты.Найти("Договор") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Договор = ДокументРасчетов.Договор;
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого ИмяРеквизита Из СтрРазделить("ОтсрочкаОплаты,ОтсрочкаОплатыДней,СрокОплатыДней,ОтсрочкаДней",
		",", Ложь) Цикл
		Если Договор.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Возврат Макс(0, Договор[ИмяРеквизита]);
	КонецЦикла;

	Возврат 0;

КонецФункции

// Пересчитывает сумму из валюты в валюту учета по курсу на дату.
// Если валюта не задана или курс не найден, сумма возвращается без изменений:
// контроль продолжает работать и не блокирует отгрузки из-за отсутствия курса.
//
// Параметры:
//  Сумма - Число - Пересчитываемая сумма.
//  Валюта - СправочникСсылка.Валюты, Неопределено - Валюта суммы.
//  ДатаПроверки - Дата - Дата, на которую берется курс.
//
// Возвращаемое значение:
//  Число - Сумма в валюте учета.
//
Функция ПересчитатьВВалютуУчета(Сумма, Валюта, ДатаПроверки) Экспорт

	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Возврат Сумма;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Курсы.Курс КАК Курс,
	|	Курсы.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаПроверки, Валюта = &Валюта) КАК Курсы";
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("Валюта", Валюта);

	Попытка

		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() ИЛИ Выборка.Кратность <= 0 Тогда
			Возврат Сумма;
		КонецЕсли;

		Возврат Сумма * Выборка.Курс / Выборка.Кратность;

	Исключение
		// Курсы валют - объект типовой конфигурации: если он недоступен или назван
		// иначе, долг сравнивается в валюте регистра без пересчета.
		Возврат Сумма;
	КонецПопытки;

КонецФункции

// Записывает версию настроек лимита в периодический регистр сведений.
// Вызывается при записи элемента справочника "Лимиты взаиморасчетов": старые
// версии остаются в регистре и применяются к документам, проведенным задним числом.
//
// Параметры:
//  ЛимитОбъект - СправочникОбъект.БНС_ЛимитыВзаиморасчетов - Записываемый элемент справочника.
//  Отказ - Булево - Признак отказа в записи элемента справочника.
//
Процедура ЗаписатьВерсиюЛимита(ЛимитОбъект, Отказ = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(ЛимитОбъект.ОбъектКонтроля) Тогда
		// Правило без объекта контроля не применяется, запись не блокируется.
		Возврат;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.БНС_ЗначенияЛимитов.СоздатьМенеджерЗаписи();
		Запись.Период                    = ?(ЗначениеЗаполнено(ЛимитОбъект.ДействуетС),
			НачалоДня(ЛимитОбъект.ДействуетС), НачалоДня(ТекущаяДатаСеанса()));
		Запись.Лимит                     = ЛимитОбъект.Ссылка;
		Запись.ОбъектКонтроля            = ЛимитОбъект.ОбъектКонтроля;
		Запись.Организация               = ЛимитОбъект.Организация;
		Запись.ЛимитСуммы                = ЛимитОбъект.ЛимитСуммы;
		Запись.Валюта                    = ЛимитОбъект.Валюта;
		Запись.ДопустимаяПросрочкаДней    = ЛимитОбъект.ДопустимаяПросрочкаДней;
		Запись.ДействиеПриНарушении       = ?(ЗначениеЗаполнено(ЛимитОбъект.ДействиеПриНарушении),
			ЛимитОбъект.ДействиеПриНарушении,
			Перечисления.БНС_ДействияПриНарушении.Предупредить);
		Запись.ДействуетПо                = ЛимитОбъект.ДействуетПо;
		Запись.Активна                    = ЛимитОбъект.Активна И Не ЛимитОбъект.ПометкаУдаления;
		Запись.Комментарий                = ЛимитОбъект.Комментарий;
		Запись.Автор                      = Пользователи.АвторизованныйПользователь();
		Запись.Записать(Истина);

	Исключение
		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Не удалось записать версию лимита: " + ОписаниеОшибки(), ЛимитОбъект);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет статус документа и снимок проверки, при необходимости отказывает в проведении.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Результат - Структура - Результат расчета контроля.
//  Отказ - Булево - Признак отказа в проведении.
//  ПоказыватьСообщение - Булево - Выводить расшифровку нарушения пользователю.
//
Процедура ПрименитьРезультат(ДокументОбъект, Результат, Отказ, ПоказыватьСообщение = Истина)

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;
	СтарыйСтатус = ДокументОбъект.БНС_СтатусФинансовогоКонтроля;
	НовыйСтатус = Статусы.Пусто;

	Если Не Результат.Применим Тогда
		ОчиститьСнимок(ДокументОбъект);
	Иначе
		ЗаполнитьСнимок(ДокументОбъект, Результат);
		Если Результат.ЕстьНарушение Тогда
			НовыйСтатус = Статусы.НаПроверке;
		КонецЕсли;
	КонецЕсли;

	ДокументОбъект.БНС_СтатусФинансовогоКонтроля = НовыйСтатус;

	Если Не Результат.Применим Тогда
		Возврат;
	КонецЕсли;

	Если Результат.ЕстьНарушение Тогда
		Если Результат.Лимит.ДействиеПриНарушении
			= Перечисления.БНС_ДействияПриНарушении.Запретить Тогда
			Отказ = Истина;
			БНС_ОбщегоНазначения.ЗафиксироватьОтказ(ДокументОбъект, Результат.Текст);
		КонецЕсли;
		Если ПоказыватьСообщение Тогда
			БНС_ОбщегоНазначения.ВывестиСообщение(Результат.Текст, ДокументОбъект);
		КонецЕсли;
	КонецЕсли;

	Если Результат.ЕстьНарушение ИЛИ НовыйСтатус <> СтарыйСтатус Тогда
		БНС_ОбщегоНазначения.ЗаписатьИсторию(ДокументОбъект, НовыйСтатус, Результат);
	КонецЕсли;

КонецПроцедуры

// Заполняет снимок проверки в реквизитах документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Результат - Структура - Результат расчета контроля.
//
Процедура ЗаполнитьСнимок(ДокументОбъект, Результат)

	ДокументОбъект.БНС_ДолгНаМоментПроверки   = Результат.Задолженность.Долг;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки  = Результат.Лимит.ЛимитСуммы;
	ДокументОбъект.БНС_ПревышениеСуммы        = Результат.ПревышениеСуммы;
	ДокументОбъект.БНС_МаксПросрочкаДней      = Результат.Задолженность.МаксПросрочкаДней;
	ДокументОбъект.БНС_ПрименимыйЛимит        = Результат.Лимит.Лимит;

КонецПроцедуры

// Очищает снимок проверки в реквизитах документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//
Процедура ОчиститьСнимок(ДокументОбъект)

	ДокументОбъект.БНС_ДолгНаМоментПроверки   = 0;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки  = 0;
	ДокументОбъект.БНС_ПревышениеСуммы        = 0;
	ДокументОбъект.БНС_МаксПросрочкаДней      = 0;
	ДокументОбъект.БНС_ПрименимыйЛимит        = Справочники.БНС_ЛимитыВзаиморасчетов.ПустаяСсылка();

КонецПроцедуры

// Считает остаток долга партнера по регистру расчетов на момент проверки.
// Остатки берутся в разрезе валют и пересчитываются в валюту учета.
//
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  МоментПроверки - Дата - Момент расчета.
//
// Возвращаемое значение:
//  Число - Долг партнера в валюте учета.
//
Функция ДолгПартнера(Партнер, МоментПроверки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.Валюта КАК Валюта,
	|	СУММА(Расчеты.СуммаОстаток) КАК СуммаДолга
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Остатки(
	|			&МоментПроверки,
	|			АналитикаУчетаПоПартнерам = &Партнер) КАК Расчеты
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.Валюта";
	Запрос.УстановитьПараметр("МоментПроверки", МоментПроверки);
	Запрос.УстановитьПараметр("Партнер", Партнер);

	Долг = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Долг = Долг + ПересчитатьВВалютуУчета(Выборка.СуммаДолга, Выборка.Валюта, МоментПроверки);
	КонецЦикла;

	Возврат Долг;

КонецФункции

// Возвращает сумму движений конкретного документа по регистру расчетов.
// При проведении документ уже записал движения, поэтому его вклад нужно вычесть,
// иначе сумма документа учитывалась бы в долге дважды.
//
// Параметры:
//  Регистратор - ДокументСсылка - Проверяемый документ.
//  МоментПроверки - Дата - Момент расчета (для пересчета валюты).
//
// Возвращаемое значение:
//  Число - Сумма движений документа в валюте учета.
//
Функция СуммаДвиженийДокумента(Регистратор, МоментПроверки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.Валюта КАК Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Расчеты.Сумма
	|			ИНАЧЕ -Расчеты.Сумма
	|		КОНЕЦ) КАК СуммаДолга
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами КАК Расчеты
	|ГДЕ
	|	Расчеты.Регистратор = &Регистратор
	|	И Расчеты.Активность
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.Валюта";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);

	Сумма = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сумма = Сумма + ПересчитатьВВалютуУчета(Выборка.СуммаДолга, Выборка.Валюта, МоментПроверки);
	КонецЦикла;

	Возврат Сумма;

КонецФункции

// Заполняет расшифровку просрочки по отгрузочным документам партнера.
//
// Параметры:
//  Результат - Структура - Результат расчета задолженности, заполняется процедурой.
//  Партнер - СправочникСсылка.Партнеры - Партнер документа.
//  МоментПроверки - Дата - Момент расчета.
//
Процедура ЗаполнитьРасшифровкуПросрочки(Результат, Партнер, МоментПроверки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Расчеты.Валюта КАК Валюта,
	|	СУММА(Расчеты.СуммаОстаток) КАК СуммаДолга
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Остатки(
	|			&МоментПроверки,
	|			АналитикаУчетаПоПартнерам = &Партнер) КАК Расчеты
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.ОбъектРасчетов,
	|	Расчеты.Валюта
	|ИМЕЮЩИЕ
	|	СУММА(Расчеты.СуммаОстаток) > 0";
	Запрос.УстановитьПараметр("МоментПроверки", МоментПроверки);
	Запрос.УстановитьПараметр("Партнер", Партнер);

	Расшифровка = Результат.Расшифровка;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// Объектом расчета может быть документ (накладная, заказ) или другой
		// объект: срок оплаты отсчитывается только от документов, у них есть дата.
		Если Не ЭтоДокумент(Выборка.ОбъектРасчетов) Тогда
			Продолжить;
		КонецЕсли;

		ДатаОтгрузки = Выборка.ОбъектРасчетов.Дата;
		СуммаДолга = ПересчитатьВВалютуУчета(Выборка.СуммаДолга, Выборка.Валюта, МоментПроверки);

		СрокОплаты = КонецДня(ДатаОтгрузки + ОтсрочкаПоДоговору(Выборка.ОбъектРасчетов) * 86400);
		ДнейПросрочки = Макс(0, (НачалоДня(МоментПроверки) - НачалоДня(СрокОплаты)) / 86400);

		НоваяСтрока = Расшифровка.Добавить();
		НоваяСтрока.Документ       = Выборка.ОбъектРасчетов;
		НоваяСтрока.ДатаОтгрузки   = ДатаОтгрузки;
		НоваяСтрока.Сумма          = СуммаДолга;
		НоваяСтрока.СрокОплаты     = СрокОплаты;
		НоваяСтрока.ДнейПросрочки  = ДнейПросрочки;

		Если ДнейПросрочки > Результат.МаксПросрочкаДней Тогда
			Результат.МаксПросрочкаДней = ДнейПросрочки;
			Результат.ДокументПросрочки = Выборка.ОбъектРасчетов;
			Результат.СуммаПросрочки = СуммаДолга;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Проверяет, что объект расчета является документом.
// Конкретный вид документа не важен: у любого документа есть дата, от которой
// отсчитывается срок оплаты.
//
// Параметры:
//  ОбъектРасчетов - ЛюбаяСсылка, Неопределено - Объект расчета из регистра.
//
// Возвращаемое значение:
//  Булево - Истина, если объект расчета - документ.
//
Функция ЭтоДокумент(ОбъектРасчетов)

	Если Не ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат СтрНачинаетсяС(ОбъектРасчетов.Метаданные().ПолноеИмя(), "Документ.");
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает таблицу расшифровки просрочки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Колонки: Документ, ДатаОтгрузки, Сумма, СрокОплаты, ДнейПросрочки.
//
Функция НоваяТаблицаРасшифровки()

	Расшифровка = Новый ТаблицаЗначений;
	// Тип не задается: объектом расчета может быть документ любого вида,
	// а состав типа зависит от базы.
	Расшифровка.Колонки.Добавить("Документ");
	Расшифровка.Колонки.Добавить("ДатаОтгрузки", Новый ОписаниеТипов("Дата"));
	Расшифровка.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Расшифровка.Колонки.Добавить("СрокОплаты", Новый ОписаниеТипов("Дата"));
	Расшифровка.Колонки.Добавить("ДнейПросрочки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(9, 0)));

	Возврат Расшифровка;

КонецФункции

// Формирует текст расшифровки нарушения для пользователя.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Результат - Структура - Результат расчета контроля.
//
// Возвращаемое значение:
//  Строка - Текст сообщения.
//
Функция ТекстНарушения(ДокументОбъект, Результат)

	Лимит = Результат.Лимит;
	Задолженность = Результат.Задолженность;
	Текст = Новый Массив;

	Текст.Добавить("Финансовый контроль: лимит дебиторской задолженности превышен.");
	Текст.Добавить("Правило: " + Строка(Лимит.Лимит)
		+ " (версия от " + Формат(Лимит.Период, "ДЛФ=D") + ")");
	Текст.Добавить("Долг покупателя на " + Формат(ДокументОбъект.Дата, "ДЛФ=D") + ": "
		+ Формат(Задолженность.Долг, "ЧДЦ=2; ЧН=")
		+ ", сумма документа: " + Формат(Результат.СуммаДокумента, "ЧДЦ=2; ЧН="));
	Текст.Добавить("Прогнозный долг: " + Формат(Результат.ПрогнозныйДолг, "ЧДЦ=2; ЧН=")
		+ ", лимит: " + Формат(Лимит.ЛимитСуммы, "ЧДЦ=2; ЧН="));

	Если Результат.ПревышениеСуммы > 0 Тогда
		Текст.Добавить("Превышение лимита на сумму: "
			+ Формат(Результат.ПревышениеСуммы, "ЧДЦ=2; ЧН="));
	КонецЕсли;

	Если Результат.ПревышениеСрока > 0 Тогда
		Текст.Добавить("Просрочка сверх допустимой (" + Формат(Лимит.ДопустимаяПросрочкаДней,
			"ЧГ=0") + " дн.):");

		Для Каждого СтрокаРасшифровки Из Задолженность.Расшифровка Цикл
			Если СтрокаРасшифровки.ДнейПросрочки <= Лимит.ДопустимаяПросрочкаДней Тогда
				Продолжить;
			КонецЕсли;
			Текст.Добавить(" - " + Строка(СтрокаРасшифровки.Документ)
				+ " от " + Формат(СтрокаРасшифровки.ДатаОтгрузки, "ДЛФ=D")
				+ " на сумму " + Формат(СтрокаРасшифровки.Сумма, "ЧДЦ=2; ЧН=")
				+ ", просрочка " + Формат(СтрокаРасшифровки.ДнейПросрочки, "ЧГ=0") + " дн.");
		КонецЦикла;

		Если Задолженность.Расшифровка.Количество() = 0 Тогда
			Текст.Добавить(" - просроченные накладные не детализированы.");
		КонецЕсли;
	КонецЕсли;

	Если Лимит.ДействиеПриНарушении = Перечисления.БНС_ДействияПриНарушении.Запретить Тогда
		Текст.Добавить("Действие: проведение запрещено. Отгрузку может разрешить контролер"
			+ " кнопкой ""Разрешить отгрузку"".");
	Иначе
		Текст.Добавить("Действие: предупреждение. Документ проводится со статусом ""На проверке"".");
	КонецЕсли;

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

// Формирует текст сообщения при запрете отгрузки контролером.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//
// Возвращаемое значение:
//  Строка - Текст сообщения.
//
Функция ТекстОтказаКонтролера(ДокументОбъект)

	Текст = "Отгрузка по документу запрещена контролером финансового контроля";

	Если ЗначениеЗаполнено(ДокументОбъект.БНС_РазрешилОтгрузку) Тогда
		Текст = Текст + " (" + Строка(ДокументОбъект.БНС_РазрешилОтгрузку) + ")";
	КонецЕсли;

	Если ЗначениеЗаполнено(ДокументОбъект.БНС_ДатаРазрешения) Тогда
		Текст = Текст + " " + Формат(ДокументОбъект.БНС_ДатаРазрешения, "ДЛФ=DT");
	КонецЕсли;

	Текст = Текст + ".";

	Если ЗначениеЗаполнено(ДокументОбъект.БНС_КомментарийКонтролера) Тогда
		Текст = Текст + " Комментарий: " + ДокументОбъект.БНС_КомментарийКонтролера;
	КонецЕсли;

	Возврат Текст + Символы.ПС + "Документ можно сохранить без проведения.";

КонецФункции

#КонецОбласти
