#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие "ОбработкаПроведения" отгрузочных документов.
//
// Параметры:
//  Источник - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг - Проводимый документ.
//  Отказ - Булево - Признак отказа в проведении.
//
Процедура ПроверкаЛимитаПриПроведении(Источник, Отказ) Экспорт

	БНС_КонтрольЛимитовСервер.ПроверитьПередОтгрузкой(Источник, Отказ);

КонецПроцедуры

// Обработчик подписки на событие "ПередЗаписью" отгрузочных документов.
// Защищает статус финансового контроля от изменения пользователями без прав
// и заполняет статус при обычной записи документа.
//
// Параметры:
//  Источник - ДокументОбъект.ЗаказКлиента, ДокументОбъект.РеализацияТоваровУслуг - Записываемый документ.
//  Отказ - Булево - Признак отказа в записи.
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - Режим проведения документа.
//
Процедура ЗащитаСтатуса(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Попытка
		ВыполнитьЗащитуСтатуса(Источник, Отказ, РежимЗаписи);
	Исключение
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(Источник, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Принимает решение контролера по отгрузке: разрешает или запрещает проведение.
// Функция вызывается с сервера формами документов. Решение сохраняется отдельной
// транзакцией, чтобы запрет оставался в базе даже при отказе в проведении.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ЗаказКлиента, ДокументСсылка.РеализацияТоваровУслуг - Документ.
//  НовыйСтатус - ПеречислениеСсылка.БНС_СтатусыФинансовогоКонтроля - "Отгрузка разрешена" или "Отгрузка запрещена".
//  Комментарий - Строка - Комментарий контролера; сохраняется в реквизит документа
//                БНС_КомментарийКонтролера и попадает в историю контроля.
//
// Возвращаемое значение:
//  Структура - Результат выполнения:
//   * Успех - Булево - Истина, если решение сохранено.
//   * ТекстОшибки - Строка - Причина неудачи.
//   * ТекстСообщения - Строка - Сообщение пользователю при успехе.
//   * Статус - ПеречислениеСсылка.БНС_СтатусыФинансовогоКонтроля - Статус документа после записи.
//
Функция ПринятьРешение(ДокументСсылка, НовыйСтатус, Комментарий = "") Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки, ТекстСообщения, Статус",
		Ложь, "", "", Неопределено);

	Если Не БНС_ОбщегоНазначения.ПравоНаИзменениеСтатуса() Тогда
		Результат.ТекстОшибки = "Недостаточно прав для решения по отгрузке."
			+ " Требуется роль ""БНС_ФинансовыйКонтроль_Изменение"".";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Результат.ТекстОшибки = "Сначала сохраните документ.";
		Возврат Результат;
	КонецЕсли;

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;
	Если НовыйСтатус <> Статусы.ОтгрузкаРазрешена
		И НовыйСтатус <> Статусы.ОтгрузкаЗапрещена Тогда
		Результат.ТекстОшибки = "Контролер может установить только решение"
			+ " ""Отгрузка разрешена"" или ""Отгрузка запрещена"".";
		Возврат Результат;
	КонецЕсли;

	ДокументОбъект = Неопределено;

	Попытка
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ДокументОбъект = Неопределено Тогда
		Результат.ТекстОшибки = "Документ не найден.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		ДокументОбъект.БНС_СтатусФинансовогоКонтроля = НовыйСтатус;
		ДокументОбъект.БНС_РазрешилОтгрузку = Пользователи.АвторизованныйПользователь();
		ДокументОбъект.БНС_ДатаРазрешения = ТекущаяДатаСеанса();
		ДокументОбъект.БНС_КомментарийКонтролера = Комментарий;

		// Решение сохраняется до попытки проведения: запрет должен остаться в базе.
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.Статус = НовыйСтатус;

	Попытка
		Состояние = БНС_КонтрольЛимитовСервер.РассчитатьКонтроль(ДокументОбъект);
		БНС_ОбщегоНазначения.ЗаписатьИсторию(ДокументОбъект, НовыйСтатус, Состояние);
	Исключение
		// История не должна отменять уже принятое решение.
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(ДокументОбъект, ОписаниеОшибки());
	КонецПопытки;

	Если НовыйСтатус = Статусы.ОтгрузкаРазрешена Тогда
		Попытка
			// Проведение выполняется после сохранения решения: проверка увидит статус
			// "Отгрузка разрешена" и не будет применяться.
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Результат.ТекстСообщения = "Отгрузка разрешена. Документ проведен без проверки лимита.";
		Исключение
			Результат.ТекстСообщения = "Отгрузка разрешена, но документ не проведен: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		Результат.ТекстСообщения = "Отгрузка запрещена. Документ нельзя провести"
			+ " до нового решения контролера.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет права на изменение статуса и заполняет статус при записи.
//
// Параметры:
//  Источник - ДокументОбъект - Записываемый документ.
//  Отказ - Булево - Признак отказа в записи.
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи документа.
//
Процедура ВыполнитьЗащитуСтатуса(Источник, Отказ, РежимЗаписи)

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;
	ЕстьПрава = БНС_ОбщегоНазначения.ПравоНаИзменениеСтатуса();

	Если Источник.Ссылка.Пустая() Тогда
		// Новый документ: реквизиты решения контролера заполняются только процедурой решения.
		Источник.БНС_РазрешилОтгрузку = Справочники.Пользователи.ПустаяСсылка();
		Источник.БНС_ДатаРазрешения = Дата(1, 1, 1);
	Иначе
		ПроверитьПраваИРешение(Источник, Отказ, ЕстьПрава, РежимЗаписи);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		// При проведении контроль выполняется в обработчике проведения.
		Возврат;
	КонецЕсли;

	Если Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
		ИЛИ Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена Тогда
		// Ручное решение контролера не пересчитывается при обычной записи.
		Возврат;
	КонецЕсли;

	БНС_КонтрольЛимитовСервер.ЗаполнитьСтатусПриЗаписи(Источник);

КонецПроцедуры

// Проверяет права пользователя и сбрасывает устаревшее решение контролера.
//
// Параметры:
//  Источник - ДокументОбъект - Записываемый документ.
//  Отказ - Булево - Признак отказа в записи.
//  ЕстьПрава - Булево - Признак наличия прав на изменение статуса.
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи документа.
//
Процедура ПроверитьПраваИРешение(Источник, Отказ, ЕстьПрава, РежимЗаписи)

	Исходный = Источник.Ссылка.ПолучитьОбъект();
	Если Исходный = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;
	СтатусИзменился = Источник.БНС_СтатусФинансовогоКонтроля
		<> Исходный.БНС_СтатусФинансовогоКонтроля;

	РучноеРешение = (Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
		ИЛИ Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена);

	Если РучноеРешение И СтатусИзменился И Не ЕстьПрава Тогда
		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Недостаточно прав для изменения статуса финансового контроля."
			+ " Решение по отгрузке принимает контролер (роль "
			+ """БНС_ФинансовыйКонтроль_Изменение""").", Источник);
		Возврат;
	КонецЕсли;

	Если Не ЕстьПрава
		И (Источник.БНС_РазрешилОтгрузку <> Исходный.БНС_РазрешилОтгрузку
			ИЛИ Источник.БНС_ДатаРазрешения <> Исходный.БНС_ДатаРазрешения) Тогда
		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Поля ""Разрешил отгрузку"" и ""Дата решения"" заполняются автоматически,"
			+ " править их нельзя.", Источник);
		Возврат;
	КонецЕсли;

	// Комментарий к решению - часть решения контролера, а не свободное поле документа.
	Если Не ЕстьПрава
		И Источник.БНС_КомментарийКонтролера <> Исходный.БНС_КомментарийКонтролера Тогда
		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Комментарий к решению по отгрузке может изменить только контролер"
			+ " (роль ""БНС_ФинансовыйКонтроль_Изменение"").", Источник);
		Возврат;
	КонецЕсли;

	Если СтатусИзменился Тогда
		Если РучноеРешение Тогда
			Источник.БНС_РазрешилОтгрузку = Пользователи.АвторизованныйПользователь();
			Источник.БНС_ДатаРазрешения = ТекущаяДатаСеанса();
		Иначе
			Источник.БНС_РазрешилОтгрузку = Справочники.Пользователи.ПустаяСсылка();
			Источник.БНС_ДатаРазрешения = Дата(1, 1, 1);
		КонецЕсли;
	КонецЕсли;

	// Решение контролера относится к конкретным условиям отгрузки.
	Если Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
		И ИзменилисьУсловияОтгрузки(Источник, Исходный)
		И РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда

		Источник.БНС_СтатусФинансовогоКонтроля = Статусы.НаПроверке;
		Источник.БНС_КомментарийКонтролера = "Разрешение сброшено: изменены условия отгрузки.";
		Источник.БНС_РазрешилОтгрузку = Справочники.Пользователи.ПустаяСсылка();
		Источник.БНС_ДатаРазрешения = Дата(1, 1, 1);
	КонецЕсли;

КонецПроцедуры

// Проверяет, изменились ли условия отгрузки, на которые выдано разрешение.
//
// Параметры:
//  Источник - ДокументОбъект - Записываемый документ.
//  Исходный - ДокументОбъект - Документ в базе.
//
// Возвращаемое значение:
//  Булево - Истина, если условия изменились.
//
Функция ИзменилисьУсловияОтгрузки(Источник, Исходный)

	Если Источник.Дата <> Исходный.Дата Тогда
		Возврат Истина;
	КонецЕсли;

	Если Источник.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено
		И Источник.СуммаДокумента <> Исходный.СуммаДокумента Тогда
		Возврат Истина;
	КонецЕсли;

	Если Источник.Метаданные().Реквизиты.Найти("Партнер") <> Неопределено
		И Источник.Партнер <> Исходный.Партнер Тогда
		Возврат Истина;
	КонецЕсли;

	Если Источник.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено
		И Источник.Контрагент <> Исходный.Контрагент Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
