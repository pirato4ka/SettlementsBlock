
#Область ПрограммныйИнтерфейс

Процедура ПроверкаЛимитаПриПроведении(Источник, Отказ) Экспорт

	БНС_КонтрольЛимитовСервер.ПроверитьПередОтгрузкой(Источник, Отказ);

КонецПроцедуры

Процедура ЗащитаСтатуса(Источник, Отказ) Экспорт

	Попытка
		ВыполнитьЗащитуСтатуса(Источник, Отказ);
	Исключение
		БНС_ОбщегоНазначения.ЗафиксироватьСбой(Источник, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ВыполнитьЗащитуСтатуса(Источник, Отказ)

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Источник.Ссылка.Пустая() Тогда
		ОчиститьФинансовыйКонтроль(Источник);
		Возврат;
	КонецЕсли;

	Исходный = Источник.Ссылка.ПолучитьОбъект();
	Если Исходный = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Статусы = Перечисления.БНС_СтатусыФинансовогоКонтроля;

	СтатусИзменился = Источник.БНС_СтатусФинансовогоКонтроля <> Исходный.БНС_СтатусФинансовогоКонтроля;

	РучноеРешение = (Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
		ИЛИ Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаЗапрещена);

	ЕстьПрава = БНС_ОбщегоНазначения.ЕстьПравоизменятьСтатус();

	Если РучноеРешение И СтатусИзменился И НЕ ЕстьПрава Тогда
		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Недостаточно прав для изменения статуса финансового контроля. "
			+ "Решение по отгрузке принимает контролер (роль ""БНС финансовый контроль - изменение"").");
		Возврат;
	КонецЕсли;

	Если Не ЕстьПрава
		И (Источник.БНС_РазрешилОтгрузку <> Исходный.БНС_РазрешилОтгрузку
			ИЛИ Источник.БНС_ДатаРазрешения <> Исходный.БНС_ДатаРазрешения) Тогда

		Отказ = Истина;
		БНС_ОбщегоНазначения.ВывестиСообщение(
			"Поля ""Разрешил отгрузку"" и ""Дата решения"" заполняются автоматически, править их нельзя.");
		Возврат;
	КонецЕсли;

	Если СтатусИзменился Тогда
		Если РучноеРешение Тогда
			Источник.БНС_РазрешилОтгрузку = Пользователи.АвторизованныйПользователь();
			Источник.БНС_ДатаРазрешения = ТекущаяДатаСеанса();
		Иначе
			Источник.БНС_РазрешилОтгрузку = Справочники.Пользователи.ПустаяСсылка();
			Источник.БНС_ДатаРазрешения = Дата(1, 1, 1);
		КонецЕсли;
	КонецЕсли;

	Если Источник.БНС_СтатусФинансовогоКонтроля = Статусы.ОтгрузкаРазрешена
		И (Источник.СуммаДокумента <> Исходный.СуммаДокумента
			ИЛИ Источник.Партнер <> Исходный.Партнер
			ИЛИ Источник.Дата <> Исходный.Дата) Тогда

		Источник.БНС_СтатусФинансовогоКонтроля = Статусы.НаПроверке;
		Источник.БНС_КомментарийКонтролера = "Разрешение сброшено: изменены условия отгрузки.";
		Источник.БНС_РазрешилОтгрузку = Справочники.Пользователи.ПустаяСсылка();
		Источник.БНС_ДатаРазрешения = Дата(1, 1, 1);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьСтатусКонтроля(ДокументСсылка, НовыйСтатус, Комментарий = "") Экспорт

	Если Не БНС_ОбщегоНазначения.ЕстьПравоизменятьСтатус() Тогда
		ВызватьИсключение "Недостаточно прав для изменения статуса финансового контроля.";
	КонецЕсли;

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		ВызватьИсключение "Документ не найден.";
	КонецЕсли;

	ДокументОбъект.БНС_СтатусФинансовогоКонтроля = НовыйСтатус;
	ДокументОбъект.БНС_РазрешилОтгрузку        = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.БНС_ДатаРазрешения          = ТекущаяДатаСеанса();
	ДокументОбъект.БНС_КомментарийКонтролера   = Комментарий;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

#КонецОбласти

Процедура ОчиститьФинансовыйКонтроль(ДокументОбъект)

	ДокументОбъект.БНС_СтатусФинансовогоКонтроля = Перечисления.БНС_СтатусыФинансовогоКонтроля.Пусто;
	ДокументОбъект.БНС_ДолгНаМоментПроверки = 0;
	ДокументОбъект.БНС_ЛимитНаМоментПроверки = 0;
	ДокументОбъект.БНС_ПревышениеСуммы = 0;
	ДокументОбъект.БНС_МаксПросрочкаДней = 0;
	ДокументОбъект.БНС_ПрименимыйЛимит = Справочники.БНС_ЛимитыВзаиморасчетов.ПустаяСсылка();
	ДокументОбъект.БНС_РазрешилОтгрузку = Справочники.Пользователи.ПустаяСсылка();
	ДокументОбъект.БНС_ДатаРазрешения = Дата(1, 1, 1);
	ДокументОбъект.БНС_КомментарийКонтролера = "";

КонецПроцедуры
