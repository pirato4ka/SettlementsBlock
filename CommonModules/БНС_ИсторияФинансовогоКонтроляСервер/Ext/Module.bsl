#Область ПрограммныйИнтерфейс

// Записывает снимок проверки финансового контроля.
// Модуль привилегированный: пользователи с ролью просмотра не получают
// право изменения регистра истории.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Проверяемый документ.
//  Статус - ПеречислениеСсылка.БНС_СтатусыФинансовогоКонтроля - Статус после проверки.
//  Результат - Структура, Неопределено - Результат расчета контроля
//              (см. БНС_КонтрольЛимитовСервер.РассчитатьКонтроль).
//
Процедура ЗаписатьИсторию(ДокументОбъект, Статус, Результат = Неопределено) Экспорт

	Если ДокументОбъект = Неопределено ИЛИ ДокументОбъект.Ссылка.Пустая() Тогда
		// Для нового документа ссылки еще нет: история появится при проведении.
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.БНС_ИсторияФинансовогоКонтроля.СоздатьМенеджерЗаписи();
	Запись.Период = УникальныйПериодЗаписи(ДокументОбъект.Ссылка);
	Запись.Документ = ДокументОбъект.Ссылка;
	Запись.Статус = Статус;
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();

	Если ЗначениеРеквизитаЕсть(ДокументОбъект, "БНС_КомментарийКонтролера") Тогда
		Запись.Комментарий = ДокументОбъект.БНС_КомментарийКонтролера;
	КонецЕсли;

	Если Результат <> Неопределено И Результат.Применим Тогда
		Запись.ПрименимыйЛимит = Результат.Лимит.Лимит;
		Запись.ДействиеПриНарушении = Результат.Лимит.ДействиеПриНарушении;
		Запись.ЛимитСуммы = Результат.Лимит.ЛимитСуммы;
		Запись.Долг = Результат.Задолженность.Долг;
		Запись.СуммаДокумента = Результат.СуммаДокумента;
		Запись.Превышение = Результат.ПревышениеСуммы;
		Запись.МаксПросрочкаДней = Результат.Задолженность.МаксПросрочкаДней;
		Запись.СуммаПросрочки = Результат.Задолженность.СуммаПросрочки;

		Если ЗначениеЗаполнено(Результат.Задолженность.ДокументПросрочки) Тогда
			Запись.ДокументПросрочки = Результат.Задолженность.ДокументПросрочки;
		КонецЕсли;
	КонецЕсли;

	Запись.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает период записи истории, свободный для этого документа.
// Регистр периодический до секунды: две проверки в одну секунду не должны
// затирать друг друга.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - Проверяемый документ.
//
// Возвращаемое значение:
//  Дата - Период записи.
//
Функция УникальныйПериодЗаписи(ДокументСсылка)

	ТекущаяДата = ТекущаяДатаСеанса();
	// Регистр периодический до секунды: миллисекунды обнуляются.
	ПериодЗаписи = Дата(Год(ТекущаяДата), Месяц(ТекущаяДата), День(ТекущаяДата),
		Час(ТекущаяДата), Минута(ТекущаяДата), Секунда(ТекущаяДата));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	История.Период КАК Период
	|ИЗ
	|	РегистрСведений.БНС_ИсторияФинансовогоКонтроля КАК История
	|ГДЕ
	|	История.Документ = &Документ
	|	И История.Период = &Период";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", ПериодЗаписи);

	Попытка
		Пока Истина Цикл
			Запрос.УстановитьПараметр("Период", ПериодЗаписи);
			Если Не Запрос.Выполнить().Выбрать().Следующий() Тогда
				Прервать;
			КонецЕсли;
			ПериодЗаписи = ПериодЗаписи + 1;
		КонецЦикла;
	Исключение
		// Если проверка периода недоступна, записываем текущий период.
	КонецПопытки;

	Возврат ПериодЗаписи;

КонецФункции

// Проверяет наличие реквизита у объекта.
//
// Параметры:
//  Объект - ДокументОбъект - Проверяемый документ.
//  ИмяРеквизита - Строка - Имя реквизита.
//
// Возвращаемое значение:
//  Булево - Истина, если реквизит есть.
//
Функция ЗначениеРеквизитаЕсть(Объект, ИмяРеквизита)

	Возврат Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено;

КонецФункции

#КонецОбласти
