&НаСервере
Процедура БНС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	БНС_Кнопка("БНС_РазрешитьОтгрузку", "Разрешить отгрузку");
	БНС_Кнопка("БНС_ЗапретитьОтгрузку", "Запретить отгрузку");

	Группа = Элементы.Найти("ГруппаСтатусПриоритет");

	Если Группа = Неопределено Тогда
		Группа = Элементы.Найти("ГруппаОсновныеДанные");
	КонецЕсли;

	Если Элементы.Найти("БНС_СтатусФинансовогоКонтроля") = Неопределено Тогда
		Поле = Элементы.Добавить("БНС_СтатусФинансовогоКонтроля", Тип("ПолеФормы"), Группа);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = "Объект.БНС_СтатусФинансовогоКонтроля";
		Поле.Заголовок = "Финансовый контроль";
		Поле.ТолькоПросмотр = Истина;
		Поле.РастягиватьПоГоризонтали = Ложь;
		Поле.Ширина = 22;
	КонецЕсли;

	Если Группа <> Неопределено И Элементы.Найти("Приоритет") <> Неопределено Тогда
		Попытка
			ЭтаФорма.Элементы.Переместить(Элементы.БНС_СтатусФинансовогоКонтроля, Группа, Элементы.Приоритет);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура БНС_Кнопка(Имя, Заголовок)

	Команда = ЭтаФорма.Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;

	Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	Кнопка.ИмяКоманды = Имя;
	Кнопка.Заголовок = Заголовок;

КонецПроцедуры

&НаКлиенте
Процедура БНС_РазрешитьОтгрузку(Команда)

	БНС_ОповещенияКлиент.РазрешитьОтгрузку(Объект.Ссылка, Объект.БНС_КомментарийКонтролера);

КонецПроцедуры

&НаКлиенте
Процедура БНС_ЗапретитьОтгрузку(Команда)

	БНС_ОповещенияКлиент.ЗапретитьОтгрузку(Объект.Ссылка, Объект.БНС_КомментарийКонтролера);

КонецПроцедуры
