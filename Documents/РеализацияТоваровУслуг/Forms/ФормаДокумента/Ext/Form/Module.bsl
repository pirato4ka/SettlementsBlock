&НаСервере
Процедура БНС_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	БНС_СоздатьПолеФинансовогоКонтроля();
	БНС_СоздатьПолеКомментарияКонтролера();
	БНС_СоздатьКнопкиРешения();

КонецПроцедуры

&НаСервере
Процедура БНС_СоздатьПолеФинансовогоКонтроля()

	Если Элементы.Найти("БНС_СтатусФинансовогоКонтроля") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Родитель = Элементы.Найти("ГруппаСтатусПриоритет");
	Если Родитель = Неопределено Тогда
		Родитель = Элементы.Найти("ГруппаОсновныеДанные");
	КонецЕсли;

	Если Родитель = Неопределено Тогда
		Поле = Элементы.Добавить("БНС_СтатусФинансовогоКонтроля", Тип("ПолеФормы"));
	Иначе
		Поле = Элементы.Добавить("БНС_СтатусФинансовогоКонтроля", Тип("ПолеФормы"), Родитель);
	КонецЕсли;

	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Объект.БНС_СтатусФинансовогоКонтроля";
	Поле.Заголовок = "Финансовый контроль";
	Поле.ТолькоПросмотр = Истина;
	Поле.РастягиватьПоГоризонтали = Ложь;

	ЭлементПриоритета = Элементы.Найти("Приоритет");
	Если Родитель <> Неопределено И ЭлементПриоритета <> Неопределено Тогда
		Попытка
			Элементы.Переместить(Поле, Родитель, ЭлементПриоритета);
		Исключение
			// Порядок элементов типовой формы отличается - поле остается в своей группе.
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Показывает на форме комментарий контролера. Комментарий - реквизит документа,
// поэтому поле только отображает и редактирует его: отдельный реквизит формы не создается.
//
&НаСервере
Процедура БНС_СоздатьПолеКомментарияКонтролера()

	Если Элементы.Найти("БНС_КомментарийКонтролера") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Родитель = Элементы.Найти("ГруппаСтатусПриоритет");
	Если Родитель = Неопределено Тогда
		Родитель = Элементы.Найти("ГруппаОсновныеДанные");
	КонецЕсли;
	Если Родитель = Неопределено Тогда
		ПолеКомментария = Элементы.Добавить("БНС_КомментарийКонтролера", Тип("ПолеФормы"));
	Иначе
		ПолеКомментария = Элементы.Добавить("БНС_КомментарийКонтролера", Тип("ПолеФормы"), Родитель);
	КонецЕсли;

	ПолеКомментария.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКомментария.ПутьКДанным = "Объект.БНС_КомментарийКонтролера";
	ПолеКомментария.Заголовок = "Комментарий контролера";
	ПолеКомментария.ТолькоПросмотр = Не БНС_ОбщегоНазначения.ПравоНаИзменениеСтатуса();
	ПолеКомментария.РастягиватьПоГоризонтали = Истина;

КонецПроцедуры

&НаСервере
Процедура БНС_СоздатьКнопкиРешения()

	БНС_СоздатьКнопку("БНС_РазрешитьОтгрузку", "Разрешить отгрузку");
	БНС_СоздатьКнопку("БНС_ЗапретитьОтгрузку", "Запретить отгрузку");

КонецПроцедуры

&НаСервере
Процедура БНС_СоздатьКнопку(ИмяКоманды, Заголовок)

	Если Элементы.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтаФорма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = ЭтаФорма.Команды.Добавить(ИмяКоманды);
		Команда.Заголовок = Заголовок;
		Команда.Действие = ИмяКоманды;
	КонецЕсли;

	Родитель = Элементы.Найти("ФормаКоманднаяПанель");
	Если Родитель = Неопределено Тогда
		Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"));
	Иначе
		Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Родитель);
	КонецЕсли;

	Кнопка.ИмяКоманды = ИмяКоманды;
	Кнопка.Заголовок = Заголовок;
	Кнопка.Видимость = БНС_ОбщегоНазначения.ПравоНаИзменениеСтатуса();

КонецПроцедуры

&НаСервере
Функция БНС_ПринятьРешениеНаСервере(НовыйСтатус, Комментарий)

	Если Модифицированность Тогда
		Возврат Новый Структура("Успех, ТекстОшибки, ТекстСообщения, Статус", Ложь,
			"Сохраните документ (комментарий контролера сохраняется вместе с ним), затем повторите решение.",
			"", Неопределено);
	КонецЕсли;

	Результат = БНС_Подписки.ПринятьРешение(Объект.Ссылка, НовыйСтатус, Комментарий);

	Если Результат.Успех Тогда
		// Решение сохраняется на сервере: перечитываем объект, чтобы форма показала новый статус.
		ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
		Модифицированность = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура БНС_РазрешитьОтгрузку(Команда)

	Оповещение = Новый ОписаниеОповещения("БНС_ПослеВопросаОРешении", ЭтотОбъект,
		ПредопределенноеЗначение("Перечисление.БНС_СтатусыФинансовогоКонтроля.ОтгрузкаРазрешена"));

	ПоказатьВопрос(Оповещение,
		"Разрешить отгрузку по документу без проверки лимита дебиторской задолженности?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура БНС_ЗапретитьОтгрузку(Команда)

	Оповещение = Новый ОписаниеОповещения("БНС_ПослеВопросаОРешении", ЭтотОбъект,
		ПредопределенноеЗначение("Перечисление.БНС_СтатусыФинансовогоКонтроля.ОтгрузкаЗапрещена"));

	ПоказатьВопрос(Оповещение,
		"Запретить проведение документа до нового решения контролера?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура БНС_ПослеВопросаОРешении(РезультатВопроса, НовыйСтатус) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = БНС_ПринятьРешениеНаСервере(НовыйСтатус, Объект.БНС_КомментарийКонтролера);

	Если Результат.Успех Тогда
		БНС_ОповещенияКлиент.ОповеститьПользователя(Результат.ТекстСообщения);
	Иначе
		БНС_ОповещенияКлиент.ОповеститьОбОшибке(
			"Не удалось изменить статус финансового контроля", Результат.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры
