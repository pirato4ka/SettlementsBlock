&НаСервере
Процедура БНС_СоздатьКнопкуПерезаполненияМРЦ()

	Если Элементы.Найти("БНС_ПерезаполнитьХарактеристики") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Родитель = Элементы.Найти("ТоварыКоманднаяПанель");
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтаФорма.Команды.Найти("БНС_ПерезаполнитьХарактеристики") = Неопределено Тогда
		НоваяКоманда = ЭтаФорма.Команды.Добавить("БНС_ПерезаполнитьХарактеристики");
		НоваяКоманда.Заголовок = "Перезаполнить МРЦ (по свободным остаткам)";
		НоваяКоманда.Действие = "БНС_ПерезаполнитьХарактеристики";
	КонецЕсли;

	НовыйЭлемент = Элементы.Добавить("БНС_ПерезаполнитьХарактеристики", Тип("КнопкаФормы"), Родитель);
	НовыйЭлемент.Заголовок = "Перезаполнить МРЦ (по свободным остаткам)";
	НовыйЭлемент.ИмяКоманды = "БНС_ПерезаполнитьХарактеристики";

КонецПроцедуры

&НаКлиенте
Процедура БНС_ПерезаполнитьХарактеристики(Команда)

	БНС_ПерезаполнитьХарактеристикиНаСервере();

	ТекстОшибки = "";
	ЦеныРассчитаны = ЗаполнитьЦеныПоСоглашениюСервер(Истина, ТекстОшибки);
	СкидкиНаценкиЗаполнениеКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);
	ПродажиКлиент.ОповеститьОбОкончанииЗаполненияЦенПоСоглашению(ЦеныРассчитаны, ТекстОшибки);

	ПоказатьОповещениеПользователя("МРЦ успешно перезаполнены", ,
		"Успешно выполнено перезаполнение МРЦ", БиблиотекаКартинок.Информация,
		СтатусОповещенияПользователя.Информация);
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура БНС_ПерезаполнитьХарактеристикиНаСервере()

	ДокОбъект     = РеквизитФормыВЗначение("Объект");
	МассивТоваров = ДокОбъект.Товары.ВыгрузитьКолонку("Номенклатура");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	               |	СвободныеОстаткиОстатки.Склад КАК Склад,
	               |	СУММА(ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(ВложенныйЗапрос.КОтгрузкеОстаток, 0) - ЕСТЬNULL(ВложенныйЗапрос.ВРезервеОстаток, 0)) КАК СвободныйОстаток,
	               |	СвободныеОстаткиОстатки.Характеристика КАК Характеристика
	               |ИЗ
	               |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	               |			&ДатаОстатков,
	               |			Склад = &Склад
	               |				И Номенклатура В (&Номенклатура)) КАК СвободныеОстаткиОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток КАК КОтгрузкеОстаток,
	               |			ТоварыКОтгрузкеОстатки.ВРезервеОстаток КАК ВРезервеОстаток,
	               |			ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
	               |			ТоварыКОтгрузкеОстатки.Склад КАК Склад,
	               |			ТоварыКОтгрузкеОстатки.Характеристика КАК Характеристика
	               |		ИЗ
	               |			РегистрНакопления.ТоварыКОтгрузке.Остатки(
	               |					&ДатаОстатков,
	               |					Склад = &Склад
	               |						И Номенклатура В (&Номенклатура)) КАК ТоварыКОтгрузкеОстатки) КАК ВложенныйЗапрос
	               |		ПО СвободныеОстаткиОстатки.Номенклатура = ВложенныйЗапрос.Номенклатура
	               |			И СвободныеОстаткиОстатки.Склад = ВложенныйЗапрос.Склад
	               |			И СвободныеОстаткиОстатки.Характеристика = ВложенныйЗапрос.Характеристика
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СвободныеОстаткиОстатки.Склад,
	               |	СвободныеОстаткиОстатки.Номенклатура,
	               |	СвободныеОстаткиОстатки.Характеристика
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура,
	               |	Характеристика
	               |АВТОУПОРЯДОЧИВАНИЕ";

	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Склад"       , Объект.Склад);
	Запрос.УстановитьПараметр("Номенклатура", МассивТоваров);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Для Каждого Строка Из Объект.Товары Цикл

		Если Не Строка.ХарактеристикиИспользуются Тогда
			Продолжить;
		КонецЕсли;

		НеобходимоеКоличество = Строка.Количество;

		СтрокиТовара = РезультатЗапроса.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Строка.Номенклатура, Строка.Характеристика));
		Если СтрокиТовара.Количество() Тогда

			ТекСтрока = СтрокиТовара[0];
			Если НеобходимоеКоличество > ТекСтрока.СвободныйОстаток Тогда

				СвободноеМРЦ = РезультатЗапроса.НайтиСтроки(Новый Структура("Номенклатура", Строка.Номенклатура));
				Для Каждого СтрокаМРЦ Из СвободноеМРЦ Цикл

					Если НеобходимоеКоличество <= СтрокаМРЦ.СвободныйОстаток Тогда

						Строка.Характеристика = СтрокаМРЦ.Характеристика;
						Прервать;

					КонецЕсли;

				КонецЦикла;

			КонецЕсли;

		Иначе

			СвободноеМРЦ = РезультатЗапроса.НайтиСтроки(Новый Структура("Номенклатура", Строка.Номенклатура));
			Для Каждого СтрокаМРЦ Из СвободноеМРЦ Цикл

				Если НеобходимоеКоличество <= СтрокаМРЦ.СвободныйОстаток Тогда

					Строка.Характеристика = СтрокаМРЦ.Характеристика;
					Прервать;

				КонецЕсли;

			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
