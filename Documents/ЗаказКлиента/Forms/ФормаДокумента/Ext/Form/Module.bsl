	НовыйЭлемент.Заголовок = "Перезаполнить МРЦ (по свободным остаткам)";
	НовыйЭлемент.ИмяКоманды = "БНС_ПерезаполнитьХарактеристики";
    // -- БНС_БереговойНС 28.08.2026
	

	БНС_НастроитьПолеФинансовогоКонтроля();

	КомандаРазрешить = ЭтаФорма.Команды.Добавить("БНС_РазрешитьОтгрузку");
	КомандаРазрешить.Заголовок = "Разрешить отгрузку";
	КомандаРазрешить.Действие = "БНС_РазрешитьОтгрузку";

	КнопкаРазрешить = Элементы.Добавить("БНС_РазрешитьОтгрузку", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаРазрешить.ИмяКоманды = "БНС_РазрешитьОтгрузку";
	КнопкаРазрешить.Заголовок = "Разрешить отгрузку";

	КомандаЗапретить = ЭтаФорма.Команды.Добавить("БНС_ЗапретитьОтгрузку");
	КомандаЗапретить.Заголовок = "Запретить отгрузку";
	КомандаЗапретить.Действие = "БНС_ЗапретитьОтгрузку";

	КнопкаЗапретить = Элементы.Добавить("БНС_ЗапретитьОтгрузку", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаЗапретить.ИмяКоманды = "БНС_ЗапретитьОтгрузку";
	КнопкаЗапретить.Заголовок = "Запретить отгрузку";
КонецПроцедуры

&НаСервере
Процедура БНС_НастроитьПолеФинансовогоКонтроля()

	ГруппаЗаголовка               = Элементы.Найти("ГруппаСтатусПриоритет");
	Поле                          = Элементы.Добавить("БНС_СтатусФинансовогоКонтроля", 
													Тип("ПолеФормы"), 
													ГруппаЗаголовка);
	Поле.Вид                      = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным              = "Объект.БНС_СтатусФинансовогоКонтроля";
	Поле.Заголовок                = "Финансовый контроль";
	Поле.ТолькоПросмотр           = Истина;
	Поле.РастягиватьПоГоризонтали = Ложь;
	Поле.Ширина                   = 22;
	ЭтаФорма.Элементы.Переместить(Поле, ГруппаЗаголовка, Элементы.Приоритет);
	
	ЕстьПравоРедактирования = ПравоДоступа(
		"Редактирование", 
		Метаданные.Документы.ЗаказКлиента.Реквизиты.БНС_СтатусФинансовогоКонтроля
	);

	Если ЕстьПравоРедактирования Тогда
		
		Поле.ТолькоПросмотр           = Ложь;
		Поле.РежимВыбораИзСписка      = Истина;
		Поле.КнопкаВыпадающегоСписка  = Истина;
		Поле.КнопкаВыбора             = Ложь;

		Поле.СписокВыбора.Очистить();
		Для Каждого ЗначениеПеречисления Из Перечисления.БНС_СтатусыФинансовогоКонтроля Цикл
			Поле.СписокВыбора.Добавить(ЗначениеПеречисления);
		КонецЦикла;
		
	Иначе
		Поле.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

