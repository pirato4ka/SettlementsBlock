	// ++ БНС_БереговойНС 28.08.2026
	НоваяКоманда = ЭтаФорма.Команды.Добавить("БНС_ПерезаполнитьХарактеристики");
	НоваяКоманда.Заголовок = "Перезаполнить МРЦ (по свободным остаткам)";
	НоваяКоманда.Действие = "БНС_ПерезаполнитьХарактеристики";
	
